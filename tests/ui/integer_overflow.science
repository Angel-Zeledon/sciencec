# UI test: an integer literal too large to represent (SC0005).
#
# §4.2 admits integer literals with no upper bound written into the grammar,
# so the limit is the lexer's: it accumulates into a u128. The value below is
# u128::MAX + 1. §9 fixes only the range SC0001-SC0099; the lexer allocated
# SC0005 out of it.

function main():
    let too_big be 340282366920938463463374607431768211456
    let also_too_big be 0xFFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF_F
