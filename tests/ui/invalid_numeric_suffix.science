# UI test: a numeric literal followed by something that is not a suffix
# (SC0009).
#
# §4.2 gives the suffixes: integers take "optional suffix (`42i32`)" and floats
# are written `2.5f32`. The lexer consumes anything word-shaped after a literal
# so that `42q` stays one broken literal instead of becoming an integer next to
# an identifier `q`.

function main():
    let counted be 42q
    let ratio be 2.5i32
