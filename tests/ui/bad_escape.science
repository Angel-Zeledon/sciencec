# UI test: an escape sequence the lexer does not know (SC0006).
#
# §4.2 lists the escapes in full: "escapes `\n \t \r \\ \" \' \0 \u{1F600}`".
# Anything else is an error. A Windows path typed without doubling its
# separators is the way this happens in practice.
#
# `\u` is a known escape prefix, so `\users` is reported as a *malformed*
# `\u` escape rather than an unknown one. Both messages are SC0006.

def main():
    let path be "C:\users\link\bin"
    let escaped be "a \q here"
