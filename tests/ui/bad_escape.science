# UI test: an escape sequence the lexer does not know (SC0006).
#
# §4.1 lists the escapes in full: `\n`, `\t`, `\r`, `\\`, `\"`, `\'`, `\0` and
# `\u{...}`. Anything else is an error. A Windows path typed without doubling
# its separators is the way this happens in practice.
#
# `\u` is a known escape prefix, so `\users` is reported as a *malformed*
# `\u` escape rather than an unknown one. Both messages are SC0006.

fn main():
    let path = "C:\users\link\bin"
    let escaped = "a \q here"
