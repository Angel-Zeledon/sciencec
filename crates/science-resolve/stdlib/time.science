# time — `stdlib-standard.md` §3: `use time (Duration, Monotonic, Instant, now)`.
#
# The second module of the standard library written in Science, after `io`,
# and bundled the same way (`science_resolve::stdlib`). §3.6's five signatures
# are the surface; what this file adds to them is named below.
#
# Six decisions are this file's, and each is written where it applies:
#
# - `Instant` and `Duration` live here, at Level 2, where §3.1 puts them at
#   Level 1. It is `io`'s reason for `File`: the prelude is declared as data
#   and cannot hold a body, and every method below has one. Moving them back
#   is a `use` line, the day the prelude can hold Science.
# - Order is an operator. `Ord` has its method now — `less`, by
#   `stdlib-shape-and-packages.md` §4.5's AMENDMENT 1 — so `Duration` and
#   `Instant` implement it beside `Eq`, and `a < b`, `>`, `<=` and `>=` work
#   on both, as `is` and `is not` already did. Comparing `nanoseconds()` was
#   the workaround while it had none, and it still gives the same answer.
# - `Monotonic` has `elapsed()` beside §3.3's `since`, as Rust's `Instant`
#   does. It is `Monotonic.now().since(self)` and reads the clock exactly as
#   that does, so it adds a spelling and no capability.
# - The clocks are `ambient` seeds (`reproducibility.md` Decision 4; `effects.md`
#   §3.1): `now`, `Monotonic.now`, `since` and `elapsed`. Nothing here marks
#   them, because the bit is *inferred* from the `extern` calls they make, and
#   the query that infers it does not exist yet. `sleep` reads no clock and
#   is not one.
# - `Civil` covers UTC only, and `time.zones` is not here: §3.2 evicts it to
#   Level 3, which does not ship. A program that needs local time cannot have
#   it from this module, by decision.
# - `format_rfc3339` and `parse_rfc3339` are the one text format (§3.4). An
#   `Instant` displays as its RFC 3339 form, always `Z`; a fraction of a second
#   is written only when there is one, with its trailing zeros dropped.
#
# Ranges, stated: an `Instant` is I64 nanoseconds since 1970-01-01T00:00:00Z,
# so it covers 1677-09-21 to 2262-04-11, and leap seconds are ignored as POSIX
# ignores them (§3.3) — `Monotonic` is the clock for elapsed SI time.

# `science-rt`'s three clock entry points (`science-rt/src/time.rs`), called
# from here and from nowhere else. Everything crosses as I64 nanoseconds.
unsafe extern "C" library "science-rt":
    def science_time_monotonic_nanos() -> I64
    def science_time_unix_nanos() -> I64
    def science_time_sleep_nanos(nanos: I64)

# --- integer helpers ----------------------------------------------------------

# `/` truncates toward zero; a calendar needs the floor, or 1969 is off by one.
def floor_div(value: Int, divisor: Int) -> Int:
    let quotient be value / divisor
    if value % divisor is not 0 and (value < 0) is not (divisor < 0):
        return quotient - 1
    quotient

def floor_rem(value: Int, divisor: Int) -> Int:
    value - floor_div(value, divisor) * divisor

# `value`, at least `width` digits, zero-padded on the left. `value >= 0`.
def padded(value: Int, width: Int) -> String:
    let digits be f"{value}"
    let mutable out be String.new()
    for _ in digits.length()..width:
        out.push_str("0")
    out.push_str(digits)
    out

# A fraction of `unit` written as `.ddd` with its trailing zeros dropped, or
# nothing when it is zero. `width` is the number of digits `unit` has.
def fraction(value: Int, width: Int) -> String:
    let mutable out be String.new()
    if value is 0:
        return out
    let mutable trimmed be value
    let mutable digits be width
    loop:
        if trimmed % 10 is not 0:
            break
        trimmed be trimmed / 10
        digits be digits - 1
    out.push_str(".")
    out.push_str(padded(trimmed, digits))
    out

# --- Duration -----------------------------------------------------------------

# A signed span of time, in nanoseconds (§3.1). Not a calendar quantity: "one
# month" is not a `Duration`, because its length depends on the month (§3.4).
public type Duration:
    nanos: Int

Duration implements Copy

Duration implements Clone:
    def clone(self) -> Duration:
        Duration(nanos: self.nanos)

Duration has:
    public def from_nanoseconds(count: Int) -> Duration:
        Duration(nanos: count)

    public def from_microseconds(count: Int) -> Duration:
        Duration(nanos: count * 1_000)

    public def from_milliseconds(count: Int) -> Duration:
        Duration(nanos: count * 1_000_000)

    public def from_seconds(count: Int) -> Duration:
        Duration(nanos: count * 1_000_000_000)

    # Rounded to the nearest nanosecond.
    public def from_seconds_f64(seconds: F64) -> Duration:
        let scaled be seconds * 1_000_000_000.0
        if scaled < 0.0:
            return Duration(nanos: (scaled - 0.5) as Int)
        Duration(nanos: (scaled + 0.5) as Int)

    public def zero() -> Duration:
        Duration(nanos: 0)

    # The whole span, in nanoseconds. This is the exact value; the other two
    # readings round it.
    public def nanoseconds(self) -> Int:
        self.nanos

    # Whole milliseconds, truncated toward zero.
    public def milliseconds(self) -> Int:
        self.nanos / 1_000_000

    # Seconds, as a float: §3.7's `elapsed.seconds()`.
    public def seconds(self) -> F64:
        self.nanos as F64 / 1_000_000_000.0

    public def is_negative(self) -> Bool:
        self.nanos < 0

Duration implements Add:
    def add(self, other: Duration) -> Duration:
        Duration(nanos: self.nanos + other.nanos)

Duration implements Sub:
    def sub(self, other: Duration) -> Duration:
        Duration(nanos: self.nanos - other.nanos)

Duration implements Mul:
    def mul(self, times: Int) -> Duration:
        Duration(nanos: self.nanos * times)

Duration implements Neg:
    def neg(self) -> Duration:
        Duration(nanos: -self.nanos)

Duration implements Eq:
    def eq(self, other: Duration) -> Bool:
        self.nanos is other.nanos

Duration implements Ord:
    def less(self, other: &Duration) -> Bool:
        self.nanos < other.nanos

# In the largest of `s`, `ms`, `µs` and `ns` that leaves a whole part, with the
# exact fraction and no trailing zeros: `1.5s`, `250ms`, `17ns`, `0s`. Integer
# arithmetic only, so the same span always prints the same text.
Duration implements Display:
    def display(self, into: &mut Formatter):
        let mutable magnitude be self.nanos
        if magnitude < 0:
            into.raw("-")
            magnitude be -magnitude
        if magnitude is 0:
            into.raw("0s")
        else if magnitude >= 1_000_000_000:
            into.integer(magnitude / 1_000_000_000)
            into.raw(fraction(magnitude % 1_000_000_000, 9))
            into.raw("s")
        else if magnitude >= 1_000_000:
            into.integer(magnitude / 1_000_000)
            into.raw(fraction(magnitude % 1_000_000, 6))
            into.raw("ms")
        else if magnitude >= 1_000:
            into.integer(magnitude / 1_000)
            into.raw(fraction(magnitude % 1_000, 3))
            into.raw("µs")
        else:
            into.integer(magnitude)
            into.raw("ns")

# --- Monotonic ----------------------------------------------------------------

# A reading of a clock that does not go backwards. It has no epoch, so it has
# no conversion to or from `Instant` and no calendar (§3.3): the one thing it
# does is measure the time between two readings.
public type Monotonic:
    nanos: Int

Monotonic implements Copy

Monotonic has:
    public def now() -> Monotonic:
        Monotonic(nanos: unsafe: science_time_monotonic_nanos())

    # Elapsed time between two readings: the only thing a `Monotonic` does.
    public def since(self, earlier: Monotonic) -> Duration:
        Duration(nanos: self.nanos - earlier.nanos)

    # The time since this reading was taken.
    public def elapsed(self) -> Duration:
        Monotonic.now().since(self)

# `later - earlier` is `later.since(earlier)`.
Monotonic implements Sub:
    def sub(self, earlier: Monotonic) -> Duration:
        self.since(earlier)

# A debugging form only, since a reading means nothing on its own.
Monotonic implements Display:
    def display(self, into: &mut Formatter):
        into.raw("Monotonic(")
        into.integer(self.nanos)
        into.raw("ns)")

# --- Instant ------------------------------------------------------------------

# A point on the wall clock: nanoseconds since 1970-01-01T00:00:00Z, leap
# seconds ignored. It jumps when the system clock is set — measure with
# `Monotonic`, not with two of these (§3.3).
public type Instant:
    nanos: Int

Instant implements Copy

Instant has:
    public def from_unix_nanoseconds(count: Int) -> Instant:
        Instant(nanos: count)

    public def from_unix_seconds(count: Int) -> Instant:
        Instant(nanos: count * 1_000_000_000)

    public def unix_nanoseconds(self) -> Int:
        self.nanos

    # Whole seconds since the epoch, rounded down: `-1` is 1969-12-31T23:59:59Z.
    public def unix_seconds(self) -> Int:
        floor_div(self.nanos, 1_000_000_000)

    # Proleptic Gregorian civil time in UTC. Total: every `Instant` has one.
    public def to_civil_utc(self) -> Civil:
        let seconds be floor_div(self.nanos, 1_000_000_000)
        let days be floor_div(seconds, 86_400)
        let of_day be floor_rem(seconds, 86_400)
        let date be civil_from_days(days)
        Civil(
            year: date.year,
            month: date.month,
            day: date.day,
            hour: of_day / 3_600,
            minute: of_day % 3_600 / 60,
            second: of_day % 60,
            nanosecond: floor_rem(self.nanos, 1_000_000_000),
        )

Instant implements Add:
    def add(self, span: Duration) -> Instant:
        Instant(nanos: self.nanos + span.nanoseconds())

Instant implements Eq:
    def eq(self, other: Instant) -> Bool:
        self.nanos is other.nanos

# Earlier is less: the order of the timeline, which is the order of the
# nanosecond count.
Instant implements Ord:
    def less(self, other: &Instant) -> Bool:
        self.nanos < other.nanos

Instant implements Display:
    def display(self, into: &mut Formatter):
        into.raw(format_rfc3339(self))

# The current wall-clock time, UTC. Jumps when the system clock is set.
public def now() -> Instant:
    Instant(nanos: unsafe: science_time_unix_nanos())

# Suspends the program for at least `span`; a zero or negative span returns at
# once. The operating system may oversleep, never undersleep.
public def sleep(span: Duration):
    unsafe: science_time_sleep_nanos(span.nanoseconds())

# --- Civil --------------------------------------------------------------------

# A date and a time of day in the proleptic Gregorian calendar, in UTC. Built
# by `Instant.to_civil_utc()` and by `Civil.utc`; read back by `to_instant`.
public type Civil:
    year: Int
    month: Int
    day: Int
    hour: Int
    minute: Int
    second: Int
    nanosecond: Int

Civil has:
    # The fields as given, with no fraction of a second. Nothing is checked:
    # `parse_rfc3339` is the validating door. An out-of-range field carries
    # through `to_instant`'s arithmetic — month 13 is next January — and a
    # date past 2262 wraps the I64 there.
    public def utc(
        year: Int,
        month: Int,
        day: Int,
        hour: Int,
        minute: Int,
        second: Int
    ) -> Civil:
        Civil(
            year: year,
            month: month,
            day: day,
            hour: hour,
            minute: minute,
            second: second,
            nanosecond: 0
        )

    # The `Instant` this date and time name, in UTC.
    public def to_instant(self) -> Instant:
        let days be days_from_civil(self.year, self.month, self.day)
        let seconds be days * 86_400 + self.hour * 3_600 + self.minute * 60 + self.second
        Instant(nanos: seconds * 1_000_000_000 + self.nanosecond)

Civil implements Display:
    def display(self, into: &mut Formatter):
        into.raw(padded(self.year, 4))
        into.raw("-")
        into.raw(padded(self.month, 2))
        into.raw("-")
        into.raw(padded(self.day, 2))
        into.raw("T")
        into.raw(padded(self.hour, 2))
        into.raw(":")
        into.raw(padded(self.minute, 2))
        into.raw(":")
        into.raw(padded(self.second, 2))
        into.raw(fraction(self.nanosecond, 9))
        into.raw("Z")

# The year, month and day of a count of days since 1970-01-01. Howard
# Hinnant's `civil_from_days`, the published proleptic Gregorian algorithm
# §3.5 names, over 400-year eras so it holds before the epoch as well.
type Date:
    year: Int
    month: Int
    day: Int

def civil_from_days(days: Int) -> Date:
    let shifted be days + 719_468
    let era be floor_div(shifted, 146_097)
    let of_era be shifted - era * 146_097
    let leap_days be of_era / 1_460 - of_era / 36_524 + of_era / 146_096
    let year_of_era be (of_era - leap_days) / 365
    let day_of_year be of_era - (365 * year_of_era + year_of_era / 4 - year_of_era / 100)
    let shifted_month be (5 * day_of_year + 2) / 153
    let day be day_of_year - (153 * shifted_month + 2) / 5 + 1
    let month be if shifted_month < 10: shifted_month + 3 else: shifted_month - 9
    let year be year_of_era + era * 400 + (if month <= 2: 1 else: 0)
    Date(year: year, month: month, day: day)

# The inverse: the count of days since 1970-01-01 of a civil date.
def days_from_civil(year: Int, month: Int, day: Int) -> Int:
    let shifted_year be if month <= 2: year - 1 else: year
    let era be floor_div(shifted_year, 400)
    let year_of_era be shifted_year - era * 400
    let shifted_month be if month > 2: month - 3 else: month + 9
    let day_of_year be (153 * shifted_month + 2) / 5 + day - 1
    let day_of_era be year_of_era * 365 + year_of_era / 4 - year_of_era / 100 + day_of_year
    era * 146_097 + day_of_era - 719_468

# --- RFC 3339 -----------------------------------------------------------------

# `2000-02-29T12:00:00Z`, or with a fraction: `…T12:00:00.25Z`. Always UTC.
public def format_rfc3339(instant: Instant) -> String:
    f"{instant.to_civil_utc()}"

# What `parse_rfc3339` refused, and where: `at` is the byte offset of the
# first character it could not accept.
public type TimeError:
    reason: String
    at: Int

TimeError implements Error:
    def message(self) -> String:
        f"{self.reason} at byte {self.at}"

# The byte at `at` as an `Int`, or `-1` past the end.
def byte_at(bytes: &Array[U8], at: Int) -> Int:
    let found be bytes.get(at)
    if found?:
        return found as Int
    -1

# The `count`-digit decimal number at `at`, or `-1` if any of it is not a digit.
def number_at(bytes: &Array[U8], at: Int, count: Int) -> Int:
    let mutable value be 0
    for offset in 0..count:
        let byte be byte_at(bytes, at + offset)
        if byte < 48 or byte > 57:
            return -1
        value be value * 10 + byte - 48
    value

def days_in_month(year: Int, month: Int) -> Int:
    if month is 2:
        let leap be year % 4 is 0 and (year % 100 is not 0 or year % 400 is 0)
        return if leap: 29 else: 28
    if month is 4 or month is 6 or month is 9 or month is 11:
        return 30
    31

def refused(reason: String, at: Int) -> (Instant, TimeError?):
    (Instant(nanos: 0), TimeError(reason: reason, at: at))

# RFC 3339 with a mandatory offset (§3.6): `YYYY-MM-DDTHH:MM:SS`, an optional
# fraction of any length (digits past the ninth are dropped, not rounded), and
# `Z` or `±HH:MM`. `t` and `z` are accepted for `T` and `Z`, as §5.6 of the
# RFC allows. A leap second, `:60`, is refused: an `Instant` ignores leap
# seconds (§3.3), so there is no `Instant` for it to be.
public def parse_rfc3339(text: &String) -> (Instant, TimeError?):
    let bytes be text.bytes()
    let year be number_at(bytes, 0, 4)
    if year < 0 or byte_at(bytes, 4) is not 45:
        return refused("expected a four-digit year and `-`", 0)
    let month be number_at(bytes, 5, 2)
    if month < 1 or month > 12 or byte_at(bytes, 7) is not 45:
        return refused("expected a month from 01 to 12 and `-`", 5)
    let day be number_at(bytes, 8, 2)
    if day < 1 or day > days_in_month(year, month):
        return refused("expected a day that month has", 8)
    let separator be byte_at(bytes, 10)
    if separator is not 84 and separator is not 116:
        return refused("expected `T` between the date and the time", 10)
    let hour be number_at(bytes, 11, 2)
    if hour < 0 or hour > 23 or byte_at(bytes, 13) is not 58:
        return refused("expected an hour from 00 to 23 and `:`", 11)
    let minute be number_at(bytes, 14, 2)
    if minute < 0 or minute > 59 or byte_at(bytes, 16) is not 58:
        return refused("expected a minute from 00 to 59 and `:`", 14)
    let second be number_at(bytes, 17, 2)
    if second < 0 or second > 59:
        return refused("expected a second from 00 to 59", 17)
    let mutable at be 19
    let mutable nanosecond be 0
    if byte_at(bytes, at) is 46:
        at be at + 1
        let mutable scale be 100_000_000
        let first be at
        loop:
            let digit be number_at(bytes, at, 1)
            if digit < 0:
                break
            nanosecond be nanosecond + digit * scale
            scale be scale / 10
            at be at + 1
        if at is first:
            return refused("expected a digit after `.`", at)
    let mutable offset be 0
    let zone be byte_at(bytes, at)
    if zone is 90 or zone is 122:
        at be at + 1
    else if zone is 43 or zone is 45:
        let hours be number_at(bytes, at + 1, 2)
        let minutes be number_at(bytes, at + 4, 2)
        let colon be byte_at(bytes, at + 3)
        if hours < 0 or hours > 23 or colon is not 58 or minutes < 0 or minutes > 59:
            return refused("expected an offset `±HH:MM`", at)
        offset be hours * 3_600 + minutes * 60
        if zone is 45:
            offset be -offset
        at be at + 6
    else:
        return refused("expected `Z` or an offset `±HH:MM`", at)
    if at is not text.length():
        return refused("expected the end of the text", at)
    let days be days_from_civil(year, month, day)
    let local be days * 86_400 + hour * 3_600 + minute * 60 + second
    let seconds be local - offset
    # An I64 of nanoseconds holds 1677-09-21 to 2262-04-11; past either end
    # the multiplication below would wrap, so the text is refused instead.
    if seconds < -9_223_372_036 or seconds > 9_223_372_035:
        return refused("expected a time from 1677-09-21 to 2262-04-11", 0)
    (Instant(nanos: seconds * 1_000_000_000 + nanosecond), null)
