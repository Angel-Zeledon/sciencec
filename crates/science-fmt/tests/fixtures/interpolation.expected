# `f"…"` and `r"…"`, which the corpus does not reach.
#
# The interesting line is the messy one: a space inside a hole is code and goes
# away, a space inside a text run is data and stays.
def report(frame: Frame, name: String):
    print(f"kept {frame.len()} of {frame.total()} rows")
    print(f"station {name} ")
    print(f"{{literal braces}}")
    print(r"\frac{a}{b}")
    print(f"")
    let width be f"{f"{name}"}".len()

# A line wider than the width that is mostly one f-string: nothing inside it is
# a place to break, so it stays whole. The interpolated calls are not bracket
# groups to explode and `.length()` is not a chain link.
def too_wide(left: Array[Int], right: Array[Int]):
    let reason be f"the first is {describe(left)} and the second {describe(right)}, which is {left.length()} against {right.length()}"
