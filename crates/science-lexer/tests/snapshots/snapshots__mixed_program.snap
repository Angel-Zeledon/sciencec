== source ==
|use text.parser (Token, lex)
|
|struct Doc:
|    title: String
|    body: String
|
|fn largest[T: Ord](items: &Array[T]) -> &T:
|    let mut best = items.get(0)
|    for item in items:
|        if item > best: best = item
|    best
|
|fn read_config(path: &String) -> Result[Config, Error]:
|    let text = read_file(path)?   # early return on error
|    match parse(&text):
|        Ok(value): value
|        Err(e): panic(e)
|

