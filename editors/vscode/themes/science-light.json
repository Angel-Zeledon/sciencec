  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment.science"],
      "settings": { "foreground": "#66708a", "fontStyle": "italic" }
    },
    {
      "name": "Keyword and operator",
      "scope": [
        "keyword.declaration.science",
        "keyword.control.science",
        "keyword.other.extern.science",
        "keyword.operator.science"
      ],
      "settings": { "foreground": "#c0117f" }
    },
    {
      "name": "Reserved for a later phase, not usable today",
      "scope": ["invalid.deprecated.reserved.science"],
      "settings": { "foreground": "#b23a3a", "fontStyle": "underline" }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type.science",
        "entity.name.type.unit.science",
        "punctuation.definition.unit.begin.science",
        "punctuation.definition.unit.end.science"
      ],
      "settings": { "foreground": "#0a6c85" }
    },
    {
      "name": "Function",
      "scope": ["entity.name.function.science"],
      "settings": { "foreground": "#0d7a4e" }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string.begin.science",
        "punctuation.definition.string.end.science"
      ],
      "settings": { "foreground": "#6d6a00" }
    },
    {
      "name": "Number and escape",
      "scope": ["constant.numeric", "constant.character.escape"],
      "settings": { "foreground": "#7b3fd4" }
    },
    {
      "name": "Parameter, field and label",
      "scope": ["variable.parameter.science"],
      "settings": { "foreground": "#9e5800", "fontStyle": "italic" }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation.section.brackets.science",
        "punctuation.separator.science",
        "punctuation.accessor.science"
      ],
      "settings": { "foreground": "#5b6579" }
    },
    {
      "name": "Not in the language",
      "scope": ["invalid.illegal"],
      "settings": { "foreground": "#c0117f", "fontStyle": "underline" }
    }
  ]
}
