{
  "name": "science-lang",
  "displayName": "Science",
  "description": "Syntax highlighting, editor configuration and two colour themes for the Science programming language.",
  "version": "0.1.0",
  "publisher": "science-lang",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "keywords": [
    "science",
    "scientific computing",
    "syntax highlighting",
    "theme"
  ],
  "galleryBanner": {
    "color": "#0d1412",
    "theme": "dark"
  },
  "contributes": {
    "languages": [
      {
        "id": "science",
        "aliases": [
          "Science",
          "science"
        ],
        "extensions": [
          ".science"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "science",
        "scopeName": "source.science",
        "path": "./syntaxes/science.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Science Neon",
        "uiTheme": "vs-dark",
        "path": "./themes/science-dark.json"
      },
      {
        "label": "Science Light",
        "uiTheme": "vs",
        "path": "./themes/science-light.json"
      }
    ],
    "configurationDefaults": {
      "[science]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.detectIndentation": false,
        "editor.trimAutoWhitespace": true,
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true
      }
    }
  }
}
