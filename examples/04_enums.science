# 04 - Choices (sum types)
# Spec: §4.4 declarations, §4.7 qualified variants, §5.5 absence and failure.
#
# `choice` is what `enum` was. Covers: plain choices, generic choices,
# variants with positional payload, variants with several payload fields,
# choices whose payload is a borrow, and the qualified form of a variant.
#
# F0 has no variants with named fields, so every payload here is positional.
#
# The library supplies no generic choice of its own. `Option of T` and
# `Result of (T, E)` used to stand here for the one- and two-parameter forms;
# §5.5 replaced them with `T?` and a second return value, which took `Some`,
# `None`, `Ok` and `Err` with them. Those four names are now free, and the
# generic choices below are ordinary user declarations like any other.

# A C-like choice: every variant is empty.
choice Format:
    Plain
    Markdown
    Json

# Positional payloads, one per variant.
choice Token:
    Ident(String)
    Number(Int)
    Symbol(Char)
    Eof

# Several values in a single variant.
choice Shape:
    Point
    Circle(F64)
    Rect(F64, F64)
    Triangle(F64, F64, F64)

# Generic choices, exactly as §4.4 declares them. One type argument needs no
# parentheses; two do (§4.3).
choice Bound of T:
    Exact(T)
    Unbounded

choice Tagged of (T, Label):
    Untagged(T)
    Labelled(T, Label)

# A generic choice over two parameters with mixed payloads.
choice Either of (L, R):
    Left(L)
    Right(R)
    Neither

# A choice whose payload is itself a generic type. A nested `of` takes
# parentheses (§4.3).
choice Tree of T:
    Leaf(T)
    Node(Box of (Tree of T), Box of (Tree of T))

# A choice carrying a borrow: the region is inferred like any other.
choice Slot:
    Filled(borrowed String)
    Empty

# Error choices are ordinary choices.
choice ParseError:
    UnexpectedEnd
    BadDigit(Char)
    Unsupported(String)

function main():
    let format be Markdown
    let ident be Ident("width")
    let number be Number(1_024)
    let symbol be Symbol(':')
    let end be Eof

    let circle be Circle(2.0)
    let rect be Rect(3.0, 4.0)
    let triangle be Triangle(3.0, 4.0, 5.0)

    let exact be Exact(7)
    let unbounded: Bound of Int be Unbounded
    let plain: Tagged of (Int, String) be Untagged(1)
    let labelled: Tagged of (Int, String) be Labelled(2, "width")

    let left: Either of (Int, String) be Left(1)
    let right: Either of (Int, String) be Right("one")

    # `Box` is built through its associated function (§4.4): named-argument
    # construction is for record types only.
    let tree be Node(Box.new(Leaf(1)), Box.new(Leaf(2)))

    let text be "borrowed"
    let slot be Filled(borrowed text)

    # A variant may be qualified by its type, and the two spellings mean the
    # same thing (§4.7). The qualified form is what disambiguates when two
    # choices in scope share a variant name.
    let qualified be Format.Markdown
    let empty_slot be Slot.Empty
    let qualified_unbounded: Bound of Int be Bound.Unbounded
    let qualified_exact be Bound.Exact(1)

    # Absence is *not* a choice. A value that may be missing has a nullable
    # type, `?` asks whether it is there, and `null` is the one value of `T?`
    # that is not a `T` (§5.5). Nothing below is a variant of anything.
    let mutable measured: Int? be null
    # `?` evaluates to a `Bool` and never to the value, so this prints
    # `false` and then `true`, not `null` and then `42`.
    print(measured?)
    measured be 42
    print(measured?)

    # Which variant a value holds is asked with `match`, not with `is`:
    # `is` is `Eq`, and `Eq` is an interface a choice only has if it implements
    # one (§5.4). On the payload, where the type does implement `Eq`, the
    # word form is the one that reads (§4.6).
    let punctuation be match symbol:
        Symbol(c): c is ':'
        Ident(name): name is not ""
        Number(value): false
        Eof: false

    print(punctuation)
    print(number)
