# 13 - Inline block form
# Spec: §4.5. A block is introduced with `:` and an indented body, or written
# inline as a single expression on one line. The inline body ends **where the
# expression ends**, not at the end of the line:
#
#     if a.length() > b.length(): a else: b
#
# The then-branch above ends mid-line, at `else`, because `else` cannot
# continue an expression. "Fits on one line" is a consequence of that rule,
# not the rule itself.
#
# An inline body may be an expression, an assignment, or `return`, `break` or
# `continue`. It may not be a `let`, which would bind a name nothing could
# then use (`SC0109`); that rejected form lives in `tests/ui/`.
#
# A dangling `else` binds to the innermost `if` (§4.5), which is a language
# rule rather than an artefact of recursive descent.
#
# This file puts the inline form next to the indented form of the same
# construct, so a parser test can compare the two.

choice Format:
    Plain
    Markdown

# --- `if` / `else` ----------------------------------------------------------

# Inline, as written in the spec. This is a comparison of two lengths, so it
# is written with symbols (§4.6).
def longest(a: &String, b: &String) -> &String:
    if a.length() > b.length(): a else: b

# The same thing, indented.
def longest_indented(a: &String, b: &String) -> &String:
    if a.length() > b.length():
        a
    else:
        b

# An inline `if` with no `else`: its type is `()`.
def warn_if_empty(text: &String):
    if text.is_empty(): print("empty")

# An inline `if` used as the value of a binding. The `let` is outside the
# inline body, which is what makes it legal: `if flag: let chosen be 1` is
# the form §4.5 rejects.
def pick(flag: Bool) -> Int:
    let chosen be if flag: 1 else: 0
    chosen

# An inline body that is an assignment rather than an expression. Assignment
# uses `be`, the same word that binds (§4.3).
def bump_if(flag: Bool) -> Int:
    let mutable count be 0
    if flag: count be count + 1
    count

# An inline `if` as an argument to a call.
def report(flag: Bool):
    print(if flag: "yes" else: "no")

# An inline body that is a `return`.
def sign(n: Int) -> Int:
    if n < 0: return -1
    if n > 0: return 1
    0

# Chained: the `else` of an inline `if` is another inline `if`.
def bucket(n: Int) -> String:
    if n < 10: "small" else: if n < 100: "medium" else: "large"

# A dangling `else` binds to the innermost `if` (§4.5): the `else` here
# belongs to `if b`, so the outer `if` is the one with no `else` and the
# whole thing has type `()`.
def dangling(a: Bool, b: Bool):
    if a: if b: print("both") else: print("only a")

# Code that means the other thing has to use the block form.
def not_dangling(a: Bool, b: Bool):
    if a:
        if b: print("both")
    else:
        print("neither")

# --- Function bodies --------------------------------------------------------

# A single-expression def body on its own line, which is the ordinary
# indented form rather than the inline one.
def double(n: Int) -> Int:
    n * 2

# --- Loops ------------------------------------------------------------------

def drain(stack: &mut Array[Int]):
    for _ in 0..stack.length(): stack.pop()

def shout(lines: &Array[String]):
    for line in lines: print(line)

def spin(limit: &mut Int):
    loop: break

# The other two statements an inline body may be: `continue` and `break`.
def count_short(lines: &Array[String]) -> Int:
    let mutable seen be 0
    for line in lines:
        if line.is_empty(): continue
        if seen >= 5: break
        seen be seen + 1
    seen

# --- `match` arms -----------------------------------------------------------

# Every arm inline.
def name_of(format: &Format) -> String:
    match format:
        Plain: "plain"
        Markdown: "markdown"

# Arms mixing the inline and the indented form.
def describe(format: &Format) -> String:
    match format:
        Plain: "plain"
        Markdown:
            # §8 gives `String` no concatenation method, so the two halves are
            # joined with `String.new()` and `push_str`.
            let mutable out be String.new()
            out.push_str("marked")
            out.push_str("down")
            out

def main():
    print(longest("abc", "de"))
    print(longest_indented("abc", "de"))
    print(pick(true))
    print(bump_if(true))
    report(false)
    print(sign(-3))
    print(double(21))
    print(bucket(42))
    print(name_of(Plain))
    print(describe(Markdown))
    dangling(true, false)
    not_dangling(false, false)
