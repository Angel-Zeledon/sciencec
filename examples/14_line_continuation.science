# 14 - Line continuation
# Spec: §4.2 "inside unclosed parentheses or brackets, newlines and
# indentation are ignored entirely", and §4.6 "a line whose continuation
# begins with `.` continues too. Nothing else may be split this way."
#
# Every construct below spans several physical lines while being a single
# logical line. Inside brackets the indentation is decorative: the lexer emits
# no NEWLINE, INDENT or DEDENT until the bracket closes.
#
# Trailing commas are allowed in every parenthesized and bracketed list —
# arguments, parameters, generic arguments, record fields and tuples (§4.7) —
# which is what makes one-item-per-line formatting work.

type Config:
    host: String
    port: U16
    retries: U8
    verbose: Bool

choice Outcome[T, E]:
    Loaded(T)
    Rejected(E)

interface Summarize:
    def summarize(self) -> String

# --- Unclosed brackets ------------------------------------------------------

# A signature broken across lines inside its parameter list.
def connect(
    host: &String,
    port: U16,
    retries: U8,
) -> Bool:
    retries > 0

# Two or more generic parameters take parentheses (§4.3), and parentheses
# continue, so the generic parameter list breaks across lines as well.
def constrained[
    A: Summarize,
    B: Summarize,
](left: &A, right: &B) -> String:
    left.summarize()

# A `where` clause spread over the parameter parentheses and the body line.
def described[T](
    value: &T,
) -> String where T: Summarize + Clone:
    value.summarize()

# A nested generic type broken across lines. `Array[Outcome[…]]` is
# the parenthesized nesting of §4.3, and each of those parentheses continues.
def deep(
    items: &Array[
        Outcome[
            Config,
            String,
        ]
    ],
) -> Int:
    items.length()

# --- A chain broken by a leading `.` ----------------------------------------

# §4.6: a chain is broken across lines by indenting the continuation, and a
# line whose continuation begins with `.` continues. This is the only thing
# besides an unclosed bracket that may be split across lines at all.
def hosts(configs: &Array[Config]) -> Array[String]:
    configs
        .iterate()
        .discard(each.verbose)
        .map(each.host)
        .take(5)
        .collect()

# The two kinds of continuation nest: a chain broken by `.`, one of whose
# calls is itself broken inside its parentheses.
def named_hosts(configs: &Array[Config]) -> Array[String]:
    configs
        .iterate()
        .map(
            config giving config.host,
        )
        # A comment-only line takes no part (§4.2), and the chain survives it.
        .collect()  # a trailing comment on the last link

def main():
    # A call whose arguments are on separate lines.
    let ok be connect(
        "localhost",
        8080u16,
        3u8,
    )

    # Named-argument construction, one field per line.
    let config be Config(
        host: "localhost",
        port: 8080u16,
        retries: 3u8,
        verbose: false,
    )

    # A deeply nested call: the indentation inside is free-form. A parameter
    # declared `&T` is borrowed at the call site without the caller
    # writing anything (§6.3), so `config.host` is passed plainly.
    #
    # The free-form indentation is the demonstration, so it is held against
    # `sciencec fmt`, which would otherwise put every argument on one level.
    # fmt: skip
    let nested be connect(
        config.host,
            config.port,
                config.retries,
    )

    # A parenthesized expression continuing across lines. Operators may sit
    # at the end or the start of a line. A parenthesized expression has no
    # commas, so there is no trailing comma to hold it open and the marker is
    # the only thing that can.
    # fmt: skip
    let arithmetic be (
        1 +
        2 *
        3
        - 4
    )

    # A long boolean expression, one operand per line — held open by a marker
    # rather than by a comma it cannot have.
    # fmt: skip
    let predicate be (
        config.port > 0u16
        and config.retries > 0u8
        or config.verbose
    )

    # Naming a generic instantiation before an associated def call needs
    # parentheses (§4.3, `SC0116`), and those parentheses continue like any
    # other, trailing comma included (§4.7).
    let items be (
        Array[
            Outcome[
                Config,
                String,
            ]
        ]
    ).new()
    let element be items.get(
        0,
    )

    # A comment inside brackets is still a comment to end of line, and the
    # continuation survives it.
    let commented be connect(
        "localhost",  # the host
        8080u16,  # the port
        # a whole line of comment
        3u8,
    )

    print(arithmetic)
    print(predicate)
