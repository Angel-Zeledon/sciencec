# 10 - Loops
# Spec: §4.5 expressions and control flow: `for x in xs:` walks anything
# implementing `Iterate`, `0..n` is half-open and `0..=n` inclusive, and
# `loop:` takes `break` and `continue`.
#
# Covers: `for` over a collection and over a range, `loop` with a `break`
# condition, block bodies and inline bodies, `break`, `continue`, nesting,
# and a loop whose body is a `match`.

type Doc:
    title: String
    body: String

# --- 1. `for` over anything implementing `Iterate` --------------------------

function total(items: borrowed Array of Int) -> Int:
    let mutable sum be 0
    for item in items:
        sum be sum + item
    sum

function titles(docs: borrowed Array of Doc):
    for doc in docs:
        print(doc.title)

# §8 does not say `Map` implements `Iterate`, and its method set is closed,
# so a map is walked through an `Array` of its keys and `Map.get`.
function dump(settings: borrowed Map of (String, String),
        keys: borrowed Array of String):
    for key in keys:
        # `Map.get` returns `(borrowed V)?`, so the loop body asks with `?`
        # rather than matching a variant. Inside the then-branch `value` is
        # known not to be null (§5.5).
        let value be settings.get(key)
        if value?:
            print(key)
            print(value)
        else:
            print("absent")

# `String.chars` is the one iterator §8 hands out by name: it implements
# `Iterate of Char`.
function count_spaces(text: borrowed String) -> Int:
    let mutable spaces be 0
    for c in text.chars():
        if c is ' ':
            spaces be spaces + 1
    spaces

# `for` with `continue` to skip, and `break` to stop early. A search that may
# find nothing returns a nullable, and `null` is the answer when the loop
# runs out (§5.5).
function first_even(items: borrowed Array of Int) -> Int?:
    for item in items:
        if item % 2 is not 0:
            continue
        return item
    null

function count_until_zero(items: borrowed Array of Int) -> Int:
    let mutable seen be 0
    for item in items:
        if item is 0:
            break
        seen be seen + 1
    seen

# --- 2. `for` over a range --------------------------------------------------

# `0..n` is half-open: it stops one short of `n`, so this visits `0`, `1`,
# `2`, `3` and `4` (§4.5). This is the counting loop.
function ruler(width: Int) -> Int:
    let mutable marks be 0
    for i in 0..width:
        if i % 5 is 0:
            marks be marks + 1
    marks

# `0..=n` is inclusive, so this one visits `n` itself.
function triangular(n: Int) -> Int:
    let mutable sum be 0
    for i in 0..=n:
        sum be sum + i
    sum

# A range need not start at zero, and either end may be any expression. The
# ends are written with `..` and never with `:`, which already opens blocks
# and separates match arms, fields, named arguments and bounds (§4.5).
function slice_sum(items: borrowed Array of Int,
        first: Int,
        last: Int) -> Int:
    let mutable sum be 0
    for index in first..last:
        sum be sum + value_at(items, index)
    sum

function value_at(items: borrowed Array of Int, index: Int) -> Int:
    let cell be items.get(index)
    if cell?: cell else: 0

# `break` and `continue` read the same over a range as over a collection.
function first_multiple(limit: Int, factor: Int) -> Int?:
    for i in 1..=limit:
        if i % factor is not 0:
            continue
        return i
    null

# --- 3. `loop` ended by a condition -----------------------------------------

# Counting up is a range. A count that runs *down* is not a range, so it is a
# `loop` whose first statement ends it (§2.2).
function countdown(start: Int):
    let mutable n be start
    loop:
        if n <= 0:
            break
        print(n)
        n be n - 1

# The condition is what the loop is about, so it stays a condition.
function drain(stack: mutable borrowed Array of Int):
    loop:
        if stack.is_empty():
            break
        stack.pop()

# A compound condition using `and` / `or`. This one is a formula, so the
# symbols carry it better than the words would (§4.6), and negating it whole
# keeps the formula readable.
function advance(index: Int,
        limit: Int,
        items: borrowed Array of Int) -> Int:
    let mutable i be index
    loop:
        if not (i < limit and i < items.length()):
            break
        i be i + 1
    i

# --- 4. `loop` ended by a `break` in its body -------------------------------

type Reader:
    path: String
    lines: Array of String
    cursor: Int

# An inherent block, so `next_line` needs no interface to arrive through (§4.4).
Reader has:
    function new(path: String) -> Reader:
        Reader(path: path, lines: (Array of String).new(), cursor: 0)

    function next_line(mutable self) -> (borrowed String)?:
        let line be self.lines.get(self.cursor)
        self.cursor be self.cursor + 1
        line

# The exhausted case and the blank-line case are two conditions rather than
# two arms now: `?` asks whether the reader handed anything back, and the
# narrowing that follows the check is what lets `line.is_empty()` be written
# on the next line without unwrapping anything (§5.5).
function read_until_blank(handle: mutable borrowed Reader) -> Int:
    let mutable lines be 0
    loop:
        let line be handle.next_line()
        if not line?:
            break
        if line.is_empty():
            break
        lines be lines + 1
    lines

# `loop` whose body is a `match`. The absence of a value is not a variant, so
# the `?` test ends the loop and the `match` is left to do what it is for:
# distinguishing between values of a type that has cases.
function consume(tokens: mutable borrowed Array of Int) -> Int:
    let mutable kept be 0
    loop:
        let value be tokens.pop()
        if not value?:
            break
        match value:
            0: continue
            other: kept be kept + other
    kept

# --- 5. Nesting -------------------------------------------------------------

function grid_sum(rows: borrowed Array of (Array of Int)) -> Int:
    let mutable sum be 0
    for row in rows:
        for cell in row:
            if cell < 0:
                continue
            sum be sum + cell
    sum

# A range inside a range, which is the same nesting written the other way.
function checkerboard(side: Int) -> Int:
    let mutable dark be 0
    for row in 0..side:
        for column in 0..side:
            if (row + column) % 2 is 0:
                dark be dark + 1
    dark

# A `loop` inside a `loop` inside a `for`. The inner `break` ends the inner
# loop only.
function deeply_nested(rows: borrowed Array of (Array of Int)) -> Int:
    let mutable found be 0
    for row in rows:
        let mutable index be 0
        loop:
            loop:
                if not (index < row.length() and is_zero_at(row, index)):
                    break
                index be index + 1
            if index >= row.length():
                break
            found be found + 1
            index be index + 1
    found

function is_zero_at(row: borrowed Array of Int, index: Int) -> Bool:
    let cell be row.get(index)
    cell? and cell is 0

function main():
    # A collection is built through its associated function, never with the
    # named-argument form reserved for record types, and naming a generic
    # type before the `.` takes parentheses (§4.3).
    let mutable numbers be (Array of Int).new()
    numbers.push(4)
    numbers.push(0)
    numbers.push(7)

    # A parameter declared `borrowed` or `mutable borrowed` is borrowed at
    # the call site with nothing written for it (§6.3).
    print(total(numbers))
    print(count_until_zero(numbers))
    print(count_spaces("one two three"))
    print(ruler(20))
    print(triangular(4))
    print(slice_sum(numbers, 0, 2))
    print(checkerboard(8))
    countdown(3)
    drain(numbers)
