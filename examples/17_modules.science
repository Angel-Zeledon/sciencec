# 17 - Modules, imports and visibility
# Spec: §4.4 "a file is a module; a directory with a `mod.science` is a module
# containing its siblings", which is also where `use text.parser (Token, lex)`
# is written down; §4.3 gives `public` for what `pub` was.
#
# NOTE: the two `use` forms below are exactly the ones the spec writes down.
# There is no `mod` declaration in F0 — a file is already a module and a
# directory with `mod.science` is already a module, so there is nothing for
# one to do. §13 keeps `mod` reserved but unused, so writing one today is an
# error and adding one in a later phase breaks nothing.
#
# Covers: importing a whole module, importing selected names, a deeper path,
# a selection broken over several lines with a trailing comma, and `public`
# on record types, choices, interfaces, functions and inherent methods.

# Import a whole module, referred to afterwards by its path.
use text.parser

# Import selected names out of a module.
use text.parser (Token, lex)

# A deeper path, and a multi-name selection.
use compiler.frontend.lexer (Lexer, TokenKind, Span)

# A selection broken over several lines, with a trailing comma (§4.7).
use compiler.frontend.diagnostics (
    Diagnostic,
    Label,
    render,
)

# §8 gives `String` no `clone`, so an owned copy is built from `String.new()`
# and `push_str`.
def copy_of(text: &String) -> String:
    let mutable out be String.new()
    out.push_str(text)
    out

# Public items of this module. `public` is a prefix on the declaration, and
# it is what makes the item visible outside its own file (§4.3).
public type Document:
    title: String
    body: String

public choice Severity:
    Error
    Warning
    Note

public interface Report:
    def report(self) -> String

# An inherent block whose associated def and method are both public
# (§4.4). A def with no `self` receiver is reached through the type.
Document has:
    public def new(title: String) -> Document:
        Document(title: title, body: String.new())

    public def is_empty(self) -> Bool:
        self.body.is_empty()

public def parse(source: &String) -> Array[Token]:
    lex(source)

# Private by default: no `public`.
def helper(document: &Document) -> Int:
    document.body.length()

def clamp(width: U16) -> U16:
    if width < 20u16: 20u16 else: width

Document implements Report:
    def report(self) -> String:
        copy_of(self.title)

public def main():
    let source be "def main(): print(\"hi\")"

    # A parameter declared `borrowed` is &at the call site with
    # nothing written for it (§6.3).
    let tokens be parse(source)
    print(tokens.length())

    # A name imported from another module is used unqualified; a module
    # imported whole is reached through its path.
    let scratch be Document.new("scratch")
    print(scratch.is_empty())
    print(helper(scratch))
    print(clamp(8u16))
    print(text.parser.lex(source).length())
