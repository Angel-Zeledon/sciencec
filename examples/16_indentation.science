# 16 - Indentation and block nesting
# Spec: §4.2 indentation, §4.5 blocks.
#
# Spaces only. A block opens with `:` + newline + INDENT and closes with
# DEDENT, one per level closed. Blank lines and comment-only lines take no
# part. A tab in the indentation is an error (`SC0003`) and indentation
# matching no open level is an error (`SC0004`); both rejected forms live in
# `tests/ui/`, because everything in `examples/` must be accepted. This file
# is therefore the accepted side of the rule.
#
# It goes deliberately deep, and closes several levels in one step, which is
# the case that breaks a naive indentation stack.

choice Format:
    Plain
    Markdown
    Json

type Doc:
    title: String
    body: String

interface Summarize:
    def summarize(self) -> String

    def preview(self) -> String:
        # Level 3: interface body, method body.
        self.summarize().truncate(80)

Doc implements Summarize:
    def summarize(self) -> String:
        self.body.truncate(200)

# Eight levels of nesting, then a single dedent all the way back to the top.
def deep(rows: borrowed Array of (Array of Int), format: borrowed Format) -> Int:
    let mutable total be 0
    for row in rows:
        for cell in row:
            if cell > 0:
                match format:
                    Json:
                        loop:
                            if total >= cell:
                                break
                            loop:
                                if total >= cell:
                                    break
                                total be total + 1
                    Plain:
                        total be total + cell
                    Markdown:
                        total be total + 1
            else:
                total be total - 1
    total

# Closing many levels at once: the innermost statement is at level 6 and the
# next statement is back at level 1.
def dedent_several_levels(rows: borrowed Array of (Array of Int)) -> Int:
    let mutable hits be 0
    for row in rows:
        for cell in row:
            if cell is not 0:
                if cell > 0:
                    if cell > 10:
                        hits be hits + 1
    hits

# A block whose body is a single nested block, repeatedly.
def ladder(flag: Bool) -> Int:
    if flag:
        if flag:
            if flag:
                if flag:
                    if flag:
                        1
                    else:
                        2
                else:
                    3
            else:
                4
        else:
            5
    else:
        6

# An indented block that contains a construct using the inline form, so one
# line closes nothing and the next dedents.
def mixed(a: borrowed String, b: borrowed String) -> Int:
    if a.length() > 0:
        let chosen be if a.length() > b.length(): a else: b
        chosen.length()
    else:
        0

# Not every indented continuation opens a block. A chain broken by a leading
# `.` is indented too (§4.6), and it is one logical line: the indentation
# after `docs` belongs to the expression, not to a new body.
def first_headline(docs: borrowed Array of Doc) -> String?:
    docs
        .iterate()
        .map(each.title)
        .first()

# Blank lines inside a block do not close it, however many there are.
def with_gaps() -> Int:
    let a be 1


    let b be 2



    a + b

def main():
    print(ladder(true))
    print(with_gaps())
