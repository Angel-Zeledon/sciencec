# 06 - Interfaces and implementations
# Spec: §4.4 interfaces with default methods, `Type implements Interface:`,
# `Type has:`, associated functions and marker interfaces; §5.4 interface
# resolution, associated types and operator interfaces.
#
# Covers: an interface with a required method, an interface with a default
# method that calls the required one, several implementations of the same
# interface, an interface with more than one required method, an interface with
# an associated type, an inherent block with an associated function, a one-line
# marker implementation, the operator interfaces, and the library interfaces of
# §5.4.

type Doc:
    title: String
    body: String

type Note:
    text: String

type Pair[A, B]:
    first: A
    second: B

type Position:
    line: U32
    column: U32

# §8 gives `String` no `clone`; an owned copy comes out of `String.new()` and
# `push_str`, which is all §8 offers for building one.
def copy_of(text: &String) -> String:
    let mutable out be String.new()
    out.push_str(text)
    out

# An interface with one required method and one default method.
interface Summarize:
    def summarize(self) -> String

    # The default body may call any other method of the interface.
    def preview(self) -> String:
        self.summarize().truncate(80)

    # Defaults may be several, and may call each other.
    def headline(self) -> String:
        let mutable out be String.new()
        out.push_str("# ")
        out.push_str(self.preview())
        out

Doc implements Summarize:
    def summarize(self) -> String:
        self.body.truncate(200)

Note implements Summarize:
    # Only the required method: the defaults are inherited as written.
    def summarize(self) -> String:
        copy_of(self.text)

    # A default may also be overridden.
    def preview(self) -> String:
        self.text.truncate(20)

# An interface with several required methods and no defaults.
interface Render:
    def render(self) -> String
    def width(self) -> Int

Doc implements Render:
    def render(self) -> String:
        copy_of(self.title)

    def width(self) -> Int:
        self.title.length()

# An interface whose method takes an exclusive borrow of the receiver. `self` is
# the shared receiver; `mutable self` is the exclusive one (§5.4).
interface Reset:
    def reset(mutable self)

Note implements Reset:
    def reset(mutable self):
        self.text be ""

# An interface whose method consumes the receiver. Such an interface is not
# usable
# through `any Interface` and can only be dispatched statically.
#
# NOTE: §4.3 gives `self` and §5.4 gives `mutable self`, and neither is a
# by-value receiver, so the consuming form is written as an ordinary
# parameter with an explicit type. See `examples/README.md`.
interface IntoTitle:
    def into_title(self: Self) -> String

Note implements IntoTitle:
    def into_title(self: Self) -> String:
        self.text

# --- Associated types -------------------------------------------------------

# An associated type lets an interface name a type it produces rather than
# take it
# as a parameter. Without them `Iterate` cannot name its element type and no
# generic container interface can be written (§5.4).
interface Iterate:
    type Item
    def next(mutable self) -> Self.Item?

type Countdown:
    remaining: Int

Countdown implements Iterate:
    type Item is Int

    def next(mutable self) -> Self.Item?:
        if self.remaining <= 0:
            null
        else:
            self.remaining be self.remaining - 1
            self.remaining

# A second implementation with a different `Item`, which is the point: the
# element type belongs to the implementation, not to the interface.
type Letters:
    glyphs: Array[Char]
    cursor: Int

Letters implements Iterate:
    type Item is Char

    def next(mutable self) -> Self.Item?:
        let found be self.glyphs.get(self.cursor)
        self.cursor be self.cursor + 1
        found

# An interface with an associated type used as a bound: `Swap` produces a
# type the
# implementation names.
interface Swap:
    type Swapped
    def swapped(self: Self) -> Self.Swapped

Pair[A, B] implements Swap:
    type Swapped is Pair[B, A]

    def swapped(self: Self) -> Self.Swapped:
        Pair(first: self.second, second: self.first)

# --- Operator interfaces ----------------------------------------------------

# `+ - * / % ** @` and comparison are interface methods, so a user type
# takes part in arithmetic (§5.4).
type Vector2:
    x: F64
    y: F64

Vector2 implements Add:
    def add(self, other: Vector2) -> Vector2:
        Vector2(x: self.x + other.x, y: self.y + other.y)

Vector2 implements Sub:
    def sub(self, other: Vector2) -> Vector2:
        Vector2(x: self.x - other.x, y: self.y - other.y)

Vector2 implements Mul:
    def mul(self, scale: F64) -> Vector2:
        Vector2(x: self.x * scale, y: self.y * scale)

Vector2 implements Neg:
    def neg(self) -> Vector2:
        Vector2(x: -self.x, y: -self.y)

Vector2 implements Eq:
    def eq(self, other: Vector2) -> Bool:
        self.x is other.x and self.y is other.y

Vector2 implements Copy

# `Display` is what `print` requires, and it is the same interface F1's notebook
# rendering will extend (§5.4).
Vector2 implements Display:
    def display(self) -> String:
        let mutable out be String.new()
        out.push_str("a vector")
        out

# --- Inherent methods -------------------------------------------------------

# Methods that come from no interface at all. One with no `self` receiver is an
# associated def and is called through the type (§4.4).
Note has:
    def new(text: String) -> Note:
        Note(text: text)

    def empty() -> Note:
        Note(text: String.new())

    def is_empty(self) -> Bool:
        self.text.is_empty()

# --- The library interfaces of §5.4 -----------------------------------------

Note implements Clone:
    def clone(self) -> Note:
        Note(text: copy_of(self.text))

Note implements Eq:
    def eq(self, other: Note) -> Bool:
        self.text is other.text

Note implements Ord:
    def less(self, other: Note) -> Bool:
        self.text.length() < other.text.length()

Doc implements Drop:
    def drop(mutable self):
        print("dropping a doc")

Doc implements From[Note]:
    def from(note: Note) -> Self:
        Doc(title: "untitled", body: note.text)

# A marker interface has no methods, so it is implemented on one line with no
# block at all (§4.4).
Position implements Copy

Position implements Clone:
    def clone(self) -> Position:
        Position(line: self.line, column: self.column)

def main():
    let doc be Doc(title: "Regions", body: "A region is a set of program points.")
    let mutable note be Note.new("inferred, never written")

    print(doc.summarize())
    print(doc.preview())
    print(doc.headline())
    print(doc.render())
    print(doc.width())

    print(note.summarize())
    print(note.preview())
    note.reset()

    print(Note.empty().is_empty())

    let pair be Pair(first: 1, second: "one")
    let flipped be pair.swapped()
    print(flipped.first)

    # The operator interfaces, used as operators.
    let a be Vector2(x: 1.0, y: 2.0)
    let b be Vector2(x: 0.5, y: 0.5)
    print(a + b)
    print(a - b)
    print(a * 2.0)
    print(-a)

    # `is` and `is not` are the two forms of the `Eq` interface, and they
    # dispatch to the user's `eq` by construction, not by a parser rule that
    # could drift (§5.4). Both appear here on purpose: an identity test reads
    # as a sentence whether its operands are names or a whole formula.
    print(a is b)
    print(a + b is b + a)

    for value in Countdown(remaining: 3):
        print(value)
