# 19 - The F0 standard library
# Spec: §8. The whole of it: `Box of T`, `String` and `borrowed String`,
# `Array of T`, `Map of (K, V)`, `Error`, the free functions `print`, `write`,
# `panic`, `read_file` and `write_file`, and the interfaces of §5.4 — here
# `Copy`, `Clone`, `Drop`, `Eq`, `Ord`, `Iterate` and `From`.
#
# §8 says the library is small and its method sets are **closed**: anything
# not listed does not exist, and adding to the list is a spec change rather
# than a library detail. §8 names the types and the free functions but no
# longer spells the method sets out, so the names called below are the
# corpus's standing reading of them, recorded in `examples/README.md`.
# Between them they cover the whole surface the rest of the corpus uses.
#
# Two entries this file used to carry are gone. §5.5 replaced `Option of T`
# with `T?` and `Result of (T, E)` with a second return value of type
# `Error?`, and their method sets went with the types: `is_some`, `is_ok`,
# `unwrap` and `unwrap_or` name nothing now. What stands in their place is
# smaller than what it replaced — the postfix `?`, the literal `null`, and
# the narrowing that follows a successful test — but it is not shorter at the
# call site, and the sections below write out what each of those four methods
# costs to replace. That cost is the model; hiding it would teach a lie.

type Record:
    key: String
    hits: Int

choice LoadError:
    Missing(String)
    Corrupt(String)

# §8 gives `String` no `clone`. An owned copy is built out of the two methods
# it does have, which is also the only way F0 has of concatenating.
function copy_of(text: borrowed String) -> String:
    let mutable out be String.new()
    out.push_str(text)
    out

# --- Absence: `T?`, `null` and the postfix `?` ------------------------------

# A search that may find nothing returns a nullable. There is no wrapper to
# construct: the found record *is* the value, and `null` is the other one
# (§5.5).
function find(records: borrowed Array of Record, key: borrowed String) -> (borrowed Record)?:
    for record in records:
        if record.key is key:
            return record
    null

function hits_of(records: borrowed Array of Record) -> Int?:
    let first be records.get(0)
    if first?:
        return first.hits
    null

function absence_surface(records: borrowed Array of Record) -> Int:
    # A parameter declared `borrowed` is borrowed at the call site without
    # the caller writing anything (§6.3).
    #
    # `found.is_some()` was a method call; `found?` is the operator that
    # replaced it, and asking is the only thing a nullable answers.
    let found be find(records, "alpha")
    if found?:
        print("found")

    # `hits_of(records).unwrap_or(0)` was one line. This is what it costs
    # without the method: the fallback is written where it applies, and the
    # binding it fills has to be `mutable` to receive it.
    let mutable hits be 0
    let counted be hits_of(records)
    if counted?:
        hits be counted

    # `unwrap` panicked on `None`, so its replacement is the panic written
    # out — or, as here, something better than a panic, which is the reason
    # §5.5 was willing to lose the method.
    let mutable popped be 0
    let last be records.get(0)
    if not last?:
        print("no records")
    else:
        popped be last.hits

    hits + popped

# --- Failure: the pair `-> (T, Error?)` -------------------------------------

# These two hand back what §8's free functions hand them, so they are declared
# with the library's own error type rather than this file's. Converting
# `IoError` into a caller's error type is `load_record` below and
# `00_kitchen_sink.science`; here the point is only the shape the free
# functions have.
#
# `read_file` has a value and a failure, so it returns the pair. `write_file`
# has only a failure, so it returns the error alone: the value slot would be
# `()` and a name bound to it could do nothing.
function load(path: borrowed String) -> (String, IoError?):
    read_file(path)

function store(path: borrowed String, text: borrowed String) -> IoError?:
    write_file(path, text)

function failure_surface(path: borrowed String) -> String:
    # `outcome.is_ok()` was a method on a wrapper. The pair has no wrapper:
    # the call produces the two names it was always producing, and `?` asks
    # about the second of them.
    let text, err be load(path)
    if err?:
        print(err.message())
        return String.new()
    print("loaded")
    text

# Conversion between error types is written by the caller, at the return.
# Nothing converts on the way out of a call any more: `LoadError.from(err)`
# is an ordinary call to the `From` implementation at the bottom of this
# file, and it is three lines because the check, the conversion and the
# return are three separate things (§5.5).
function load_record(path: borrowed String) -> (Record, LoadError?):
    let text, err be load(path)
    if err?:
        return (Record.new(String.new()), LoadError.from(err))
    (Record.new(text), null)

# --- Box: new ---------------------------------------------------------------

# `Box` has exactly one associated function and no methods. It is never built
# with the named-argument form, which §4.4 reserves for record types.
function boxed(record: Record) -> Box of Record:
    Box.new(record)

# --- String: new, length, is_empty, push_str, truncate, starts_with, chars --

function strings() -> Int:
    # `String` owns its bytes; `borrowed String` is a view of them.
    let owned: String be "owned, UTF-8"
    let view: borrowed String be borrowed owned
    print(owned.length())
    print(view.is_empty())
    print(owned.starts_with("owned"))
    print(owned.truncate(5))

    let mutable built be String.new()
    built.push_str("one ")
    built.push_str(owned)

    # `chars` is the one iterator §8 hands out by name; it implements
    # `Iterate` with `Item` as `Char`, which is what `for` walks.
    let mutable letters be 0
    for c in built.chars():
        if c is not ' ':
            letters be letters + 1
    letters

# --- Array: new, length, is_empty, push, pop, get, get_mut ------------------

function arrays() -> Int:
    # An associated function on a generic type takes parentheses around the
    # type, because `Array of Int.new()` does not say whether `.new()`
    # belongs to `Int` or to the whole type (§4.3, SC0116).
    let mutable items: Array of Int be (Array of Int).new()
    print(items.is_empty())
    items.push(1)
    items.push(2)
    items.push(3)

    let mutable sum be 0
    for item in items:
        sum be sum + item

    print(items.length())

    # Reading goes through `get`, which returns `(borrowed T)?`: §8 gives no
    # indexing operator that can panic, because §5.5 puts absence in the type.
    let first be items.get(0)
    if first?:
        print(first)
    else:
        print("empty")

    let slot be items.get_mut(0)
    if slot?:
        slot be 10
    else:
        print("empty")

    let last be items.pop()
    if last?:
        sum be sum + last

    sum

# --- Map: new, length, insert, get, remove, contains ------------------------

function maps() -> Int:
    let mutable counts: Map of (String, Int) be (Map of (String, Int)).new()

    # `insert` returns the value it displaced, if there was one, so its
    # result is a `V?` and not a `V`.
    let displaced be counts.insert("alpha", 1)
    counts.insert("beta", 2)

    print(counts.contains("alpha"))

    let value be counts.get("alpha")
    if value?:
        print(value)
    else:
        print("absent")

    let removed be counts.remove("beta")
    if removed?:
        print(removed)
    else:
        print("nothing to remove")

    counts.length()

# --- The library interfaces -------------------------------------------------

type Position:
    line: U32
    column: U32

# `Copy`: assignment duplicates instead of moving. `Copy` carries no methods
# and F0 has no empty block, so the implementation is a single line without
# one (§4.4).
Position implements Copy

Position implements Clone:
    function clone(self) -> Position:
        Position(line: self.line, column: self.column)

Record implements Clone:
    function clone(self) -> Record:
        Record(key: copy_of(self.key), hits: self.hits)

Record implements Eq:
    function eq(self, other: borrowed Record) -> Bool:
        self.key is other.key

Record implements Ord:
    function less(self, other: borrowed Record) -> Bool:
        self.hits < other.hits

Record implements Drop:
    function drop(mutable self):
        print("record dropped")

# An inherent block alongside the interface implementations: the associated
# function is the idiomatic constructor, and needs no interface to arrive
# through (§4.4).
Record has:
    function new(key: String) -> Record:
        Record(key: key, hits: 0)

# `Iterate` is what `for` walks. Its element type is an associated type,
# so it belongs to the implementation rather than to the interface (§5.4).
type Countdown:
    remaining: Int

Countdown implements Iterate:
    type Item is Int

    function next(mutable self) -> Self.Item?:
        if self.remaining <= 0:
            null
        else:
            self.remaining be self.remaining - 1
            self.remaining

# `From` is how one error type becomes another. It used to be invisible —
# `try` called it on the way out and no section ever said that it did — and
# §5.5 took that away. The implementation still lives here; what changed is
# that the *call* is written by the caller, at the return, which is
# `load_record` above. The orphan rule (§5.4) is satisfied by `LoadError`,
# declared in this file.
LoadError implements From of IoError:
    function from(inner: IoError) -> Self:
        Missing("the file could not be read")

# --- The free functions -----------------------------------------------------

# `panic` has type `Never`, which coerces to any type (§4.7): that is what
# lets one arm of a `match` bail out while the others produce a `String`.
#
# `load_record` fails with a concrete `LoadError` and not with the `Error`
# interface, and this `match` is why: every case is a variant the compiler can
# enumerate, so a new variant added to the choice breaks this function loudly.
# The interface form would compose across a library boundary and would box;
# there is no boundary here, and the exhaustiveness is worth more (§5.5).
function required(path: borrowed String) -> String:
    let record, err be load_record(path)
    if err?:
        match err:
            Missing(missing): panic("the file is missing")
            Corrupt(corrupt): panic("the file is corrupt")
    record.key

function main():
    write("no newline")
    print("with newline")
    print(arrays())
    print(maps())
    print(strings())

    let records: Array of Record be (Array of Record).new()
    print(absence_surface(records))
    print(failure_surface("science.toml"))
    print(required("science.toml"))

    let held be boxed(Record.new("alpha"))

    for value in Countdown(remaining: 3):
        print(value)

    # `store` returns the error alone, so there is one name to bind and one
    # question to ask.
    let write_err be store("out.txt", "contents")
    if write_err?:
        print("not written")
    else:
        print("written")

    # `load_record` returns the pair, and the value is known good once the
    # error has been tested and the function has not returned (§4.5).
    let record, err be load_record("science.toml")
    if err?:
        match err:
            Missing(path): print(path)
            Corrupt(path): print(path)
    else:
        print(record.key.length())
