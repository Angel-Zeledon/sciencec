# 12 - Operators and precedence
# Spec: §4.6 precedence table, highest to lowest:
#   call, index, field access, ?
#   - not borrowed         (unary)
#   as
#   **                     (power, right-associative)
#   * / % @                (@ is matrix multiply)
#   + -
#   << >>
#   &
#   ^
#   |
#   is  is not  < > <= >=  (identity in words, order in symbols)
#   and
#   or
#
# Assignment is deliberately absent from that table: §4.6 says it is a
# statement and not an operator, which is why `let x be if c: a be b else: c`
# is not grammatical. It is still exercised below, as a statement.
#
# `?` sits at the tightest level with call, index and field access, but it is
# not error propagation: §5.5 removed `Result` and `try` together, and the
# character came free. `e?` is the postfix *presence test* — a `Bool`, true
# when `e` is not `null` — and it is a total operator, so unlike `try` it can
# only produce a value and never return from the def around it.
#
# The unary `&` and `&mut` are the words `borrowed` and `mutable borrowed`,
# which sit at the unary level and are the same words a borrow is written
# with in a type (§4.3).

type Point:
    x: Int
    y: Int

type Registry:
    points: Array of Point

def origin() -> Point:
    Point(x: 0, y: 0)

# `?` binds on the same rung as call, index and field access, and it is
# postfix, so it applies to everything to its left on that rung:
# `registry.points.get(0)?` asks about the result of the call, not about
# `registry`.
def has_first(registry: borrowed Registry) -> Bool:
    registry.points.get(0)?

# Because it binds tightest, covering *less* than the whole chain takes
# parentheses — and the presence test answers a question rather than
# unwrapping, so reading through it is `if`, not an operator.
def first_x(registry: borrowed Registry) -> Int?:
    let first be registry.points.get(0)
    if first?:
        return first.x
    null

# `?` inside a larger expression: it produces a `Bool`, so it composes with
# `and`, `or` and `not` like any other boolean.
def is_ready(registry: borrowed Registry) -> Bool:
    registry.points.get(0)? and not registry.points.is_empty()

# `@` is matrix multiply and sits with `* / %`. The library of §8 is `Box`,
# `String`, `Array`, `Map` and `Error`, with no tensor among them, so `@`
# reaches a user type through an operator interface just as `+` does (§5.4).
# Tensors arrive in F1; the operator and its precedence are F0.
type Row:
    cells: Array of Int

Row implements Add:
    def add(self, other: Row) -> Row:
        Row(cells: (Array of Int).new())

Row implements MatMul:
    def matmul(self, other: Row) -> Row:
        Row(cells: (Array of Int).new())

def main():
    let mutable a be 10
    let b be 3
    let flag be true
    let other be false

    # --- Arithmetic ---------------------------------------------------------
    let sum be a + b
    let difference be a - b
    let product be a * b
    let quotient be a / b
    let remainder be a % b

    # Unary minus and `not`.
    let negated be -a
    let inverted be not flag

    # `**` is power and is right-associative, so this is 2 ** (3 ** 2).
    let power be 2 ** 3 ** 2
    # It binds tighter than `*`, so this is 2 * (3 ** 2).
    let power_then_multiply be 2 * 3 ** 2

    # `*` binds tighter than `+`, so this is 1 + (2 * 3).
    let precedence_mul_add be 1 + 2 * 3
    # Parentheses override it.
    let grouped be (1 + 2) * 3
    # `%` sits with `*` and `/`.
    let mixed be 1 + 10 % 4 * 2

    # --- Matrix multiply ----------------------------------------------------
    let left be Row(cells: (Array of Int).new())
    let right be Row(cells: (Array of Int).new())
    # `@` sits with `*`, so it binds tighter than `+`: (left @ right) + left.
    let matmul_then_add be left @ right + left

    # --- Shifts and bitwise -------------------------------------------------
    let shifted_left be 1 << 4
    let shifted_right be 256 >> 2
    let bit_and be 0b1100 & 0b1010
    let bit_xor be 0b1100 ^ 0b1010
    let bit_or be 0b1100 | 0b1010

    # `+` binds tighter than `<<`, which binds tighter than `&`,
    # then `^`, then `|`. So this is ((1 + 1) << 2) | (0b1 ^ 0b10 & 0b11).
    let bit_precedence be 1 + 1 << 2 | 0b1 ^ 0b10 & 0b11

    # --- Identity, in words -------------------------------------------------
    #
    # `is` and `is not` are the only comparisons written as words, and they
    # sit on the comparison row with the ordering symbols rather than on one
    # of their own. They are also the *only* spelling identity has: `==` and
    # `!=` are not Science, and the lexer reports them as SC0016 and SC0017.
    let equal be a is b
    let not_equal be a is not b

    # --- Order, in symbols --------------------------------------------------
    #
    # Ordering has no word form, and needs none: `>=` is four hundred years
    # old and every reader already has it.
    let less be a < b
    let greater be a > b
    let at_most be a <= b
    let at_least be a >= b

    # Arithmetic binds tighter than comparison: (a + b) < (a * b).
    let compared be a + b < a * b
    # `is` sits at the same level: (a + b) is (a * b).
    let compared_by_identity be a + b is a * b

    # --- Logical ------------------------------------------------------------
    # `and` binds tighter than `or`, and both looser than comparison.
    let conjunction be flag and other
    let disjunction be flag or other
    let logical_precedence be a < b or a > b and flag
    let negated_comparison be not (a < b)
    # `not` is unary and binds tightest of the three, so this reads as
    # `(not flag) and other` and not as `not (flag and other)`.
    let negation_precedence be not flag and other

    # --- `as`, tighter than `**` and looser than the unary operators --------
    let widened be a as F64
    let narrowed be a as I32
    let chained_cast be a as I32 as I64
    let cast_then_multiply be a as F64 * 2.0
    let negate_then_cast be -a as F64

    # --- Calls, field access and `?` are the tightest -----------------------
    #
    # §8 says `Array` and `Map` are read through `get`, which returns a
    # nullable: there is no indexing operator that can panic. What the table
    # calls index is therefore exercised where it does still appear — naming
    # a generic instantiation before calling one of its associated functions,
    # which takes parentheses so that the `.` cannot attach to the last type
    # argument instead (§4.3).
    let registry be Registry(points: (Array of Point).new())
    let point be origin()
    let field be point.x
    let generic_then_called be (Array of Point).new()
    let generic_then_called_then_field be (Map of (String, Int)).new().length()
    let called_then_field be origin().y
    let negated_field be -point.x
    let field_arithmetic be point.x * 2 + point.y

    # Field access through a nullable goes via the presence test, since `get`
    # is the only accessor. `if` is an expression, so the whole thing is still
    # one binding (§4.5), and inside the then-branch `first` is known not to
    # be null.
    let first be registry.points.get(0)
    let nested_field be if first?: first.y else: 0

    # `?` shares its rung with call and field access and is postfix, so it
    # takes the whole chain to its left: this asks about the result of `get`,
    # not about `registry`. Covering less takes parentheses.
    let present be registry.points.get(0)?
    let both_present be registry.points.get(0)? and registry.points.get(1)?

    # --- Assignment, which is a statement rather than an operator -----------
    #
    # Reassignment uses `be`, the same word that binds: there is one word for
    # "this name now means this value" (§4.3).
    a be b
    a be a + 1
    a be if flag: 1 else: 2
    a be b * 2 + 1

    # --- `borrowed`, at the unary level with `-` and `not` ------------------
    #
    # A parameter declared borrowed is borrowed at the call site with nothing
    # written for it (§6.3), so the operator is only wanted where a borrow is
    # made outside a call. Being unary it binds looser than field access, so
    # `borrowed point.x` borrows the field and not the record.
    let shared be borrowed point
    let shared_field be borrowed point.x
    let mutable owner be origin()
    let exclusive be mutable borrowed owner
    let exclusive_field be mutable borrowed owner.y

    print(bit_precedence)
    print(logical_precedence)
    print(nested_field)

    print(has_first(registry))
    print(is_ready(registry))

    let x be first_x(registry)
    if x?:
        print(x)
    else:
        print("no points")
