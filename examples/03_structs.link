# 03 - Structs
# Spec: §4.3 structs, §6.2 regions in struct fields.
#
# Covers: struct declaration, construction with mandatory named arguments in
# any order, field access, nested structs, generic structs, and structs whose
# fields are references (the region is inferred, never written).

struct Doc:
    title: String
    body: String

# A field may be a reference. The region parameter is implicit: the
# programmer never writes a lifetime (§6.1).
struct View:
    source: &Doc

# Several reference fields, shared and exclusive.
struct Editor:
    document: &mut Doc
    template: &Doc
    revision: Int

# A struct may hold other structs by value.
struct Bundle:
    primary: Doc
    secondary: Doc
    label: String

# Generic struct (§4.3 generics).
struct Pair[A, B]:
    first: A
    second: B

# Single-field structs, one generic and one not.
struct Wrapper[T]:
    inner: T

struct Marker:
    tag: U8

# Marker traits are implemented with a single line and no block, because F0
# has no empty block (§4.3).
impl Copy for Marker

fn make_doc() -> Doc:
    # Construction: named arguments, all mandatory, in any order.
    Doc(title: "a", body: "...")

fn make_doc_reordered() -> Doc:
    Doc(body: "...", title: "a")

fn title_of(view: &View) -> &String:
    # References auto-dereference for field access, so the chain reads
    # through `source` with nothing written for it: F0 has no explicit
    # dereference operator at all (§4.5).
    &view.source.title

# A type may have methods that come from no trait, and an `impl` function
# with no `self` receiver is an associated function called through the type
# (§4.3).
impl Doc:
    fn new(title: String) -> Doc:
        Doc(title: title, body: String.new())

    fn is_empty(&self) -> Bool:
        self.body.is_empty()

# Trailing commas are allowed in every parenthesised and bracketed list,
# construction included (§4.5).
fn make_pair() -> Pair[Int, Int]:
    Pair(
        first: 1,
        second: 2,
    )

fn main():
    let doc = make_doc()

    # A struct that stores a borrow of a local. The borrow ends with `view`,
    # so `doc` is still usable afterwards.
    let view = View(source: &doc)
    println(title_of(&view))

    let bundle = Bundle(primary: doc, secondary: make_doc_reordered(), label: "pair")
    println(bundle.label)
    println(bundle.primary.title)

    let scratch = Doc.new("scratch")
    println(scratch.is_empty())
    println(make_pair().first)

    let coords = Pair(first: 3, second: 4)
    let mixed = Pair(first: "left", second: 7u8)
    let boxed_value = Wrapper(inner: 1_000)
    let marker = Marker(tag: 0xFF)

    println(coords.first)
    println(mixed.second)
    println(boxed_value.inner)
    println(marker.tag)
