# 12 - Operators and precedence
# Spec: §4.4 precedence table, highest to lowest:
#   call, index, field access, ?
#   - not & &mut        (unary)
#   as
#   * / %
#   + -
#   << >>
#   &
#   ^
#   |
#   == != < > <= >=
#   and
#   or
#
# Assignment is deliberately absent from that table: §4.4 says `x = y` is a
# statement, not an expression, which is why `let x = if c: a = b else: c` is
# not grammatical. It is still exercised below, as a statement.

struct Point:
    x: Int
    y: Int

struct Registry:
    points: Array[Point]

fn origin() -> Point:
    Point(x: 0, y: 0)

# `?` sits at the tightest level, next to call and field access.
fn first_x(registry: &Registry) -> Option[Int]:
    let first = registry.points.get(0)?
    Some(first.x)

fn main():
    let mut a = 10
    let b = 3
    let flag = true
    let other = false

    # --- Arithmetic ---------------------------------------------------------
    let sum = a + b
    let difference = a - b
    let product = a * b
    let quotient = a / b
    let remainder = a % b

    # Unary minus and `not`.
    let negated = -a
    let inverted = not flag

    # `*` binds tighter than `+`, so this is 1 + (2 * 3).
    let precedence_mul_add = 1 + 2 * 3
    # Parentheses override it.
    let grouped = (1 + 2) * 3
    # `%` sits with `*` and `/`.
    let mixed = 1 + 10 % 4 * 2

    # --- Shifts and bitwise -------------------------------------------------
    let shifted_left = 1 << 4
    let shifted_right = 256 >> 2
    let bit_and = 0b1100 & 0b1010
    let bit_xor = 0b1100 ^ 0b1010
    let bit_or = 0b1100 | 0b1010

    # `+` binds tighter than `<<`, which binds tighter than `&`,
    # then `^`, then `|`. So this is ((1 + 1) << 2) | (0b1 ^ 0b10 & 0b11).
    let bit_precedence = 1 + 1 << 2 | 0b1 ^ 0b10 & 0b11

    # --- Comparison ---------------------------------------------------------
    let equal = a == b
    let not_equal = a != b
    let less = a < b
    let greater = a > b
    let at_most = a <= b
    let at_least = a >= b

    # Arithmetic binds tighter than comparison: (a + b) < (a * b).
    let compared = a + b < a * b

    # --- Logical ------------------------------------------------------------
    # `and` binds tighter than `or`, and both looser than comparison.
    let conjunction = flag and other
    let disjunction = flag or other
    let logical_precedence = a < b or a > b and flag
    let negated_comparison = not (a < b)

    # --- `as`, tighter than `*` and looser than the unary operators ----------
    let widened = a as F64
    let narrowed = a as I32
    let chained_cast = a as I32 as I64
    let cast_then_multiply = a as F64 * 2.0
    let negate_then_cast = -a as F64

    # --- Calls, indexing, field access and `?` are the tightest -------------
    #
    # §8 says `Array` and `Map` are read through `get`, which returns an
    # `Option`: there is no indexing operator that can panic. The `[...]`
    # postfix of the precedence table is therefore exercised where it does
    # appear in expressions — naming a generic instantiation before calling
    # one of its associated functions.
    let registry = Registry(points: Array[Point].new())
    let point = origin()
    let field = point.x
    let indexed_then_called = Array[Point].new()
    let indexed_then_field_then_called = Map[String, Int].new().len()
    let called_then_field = origin().y
    let negated_field = -point.x
    let field_arithmetic = point.x * 2 + point.y

    # Field access through an `Option` goes via `match`, since `get` is the
    # only accessor.
    let nested_field = match registry.points.get(0):
        Some(first): first.y
        None: 0

    # --- Assignment, which is a statement rather than an operator -----------
    a = b
    a = a + 1
    a = if flag: 1 else: 2
    a = b * 2 + 1

    # References are unary operators.
    let shared = &point
    let shared_field = &point.x
    let mut owner = origin()
    let exclusive = &mut owner
    let exclusive_field = &mut owner.y

    println(bit_precedence)
    println(logical_precedence)
    println(nested_field)

    match first_x(&registry):
        Some(x): println(x)
        None: println("no points")
