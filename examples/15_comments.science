# 15 - Comments
# Spec: §4.2 "`#` to end of line", and "blank lines and comment-only lines
# take no part" in the indentation calculation. There are no block comments.

# A comment at column 0, before anything else.

#A comment with no space after the hash.
#### Several hashes are just part of the comment text.
# A comment containing a # hash, a "quoted string", 'c', and 0xFF.
# A comment holding words that would otherwise be keywords: function return
# let be mutable type choice implements has of borrowed any null interface
# giving >= — none of them lex, because the line ended at the hash.
# A comment with unicode: ¿qué tal? — 你好 — 😀

type Doc:      # trailing comment after a declaration header
    title: String   # trailing comment after a field
    # a comment on its own line, at field indentation
    body: String

        # A comment indented far past any real block. It does not open one:
        # comment-only lines are invisible to the indentation stack.

function main():
    # A comment as the first thing in a block.
    let mutable a be 1   # trailing comment after a statement

    # A comment-only line inside a block, followed by a blank line.

    let b be 2

# A comment at column 0 in the middle of a function does not close its block.
    let c be 3

    if a < b:
        # A comment as the only content before the real statement.
        print("less")
    # A comment between the `if` body and the `else`.
    else:
        print("not less")

    for _ in a..b:
        a be a + 1
        # A trailing comment at the end of a block.

    # A comment right before the end of the function.
    print(c)

# A comment as the last line of the file, with no trailing newline issues.
