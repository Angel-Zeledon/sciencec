# 02 - Bindings
# Spec: §4.3 (`let`, `let mut`), §5.1 primitive types, §5.2 local inference.
#
# Covers: immutable and mutable bindings, optional type annotations,
# assignment as a statement, `as` casts, and bindings of every primitive type.

fn main():
    # `let` binds immutably. The annotation is optional: it is inferred.
    let greeting = "hola"
    let answer = 42
    let annotated: Int = 42
    let widened: I64 = 42i64

    # `let mut` allows reassignment.
    let mut count = 0
    count = count + 1
    count = count * 2

    # One binding of each primitive type (§5.1).
    let a: I8 = 1i8
    let b: I16 = 2i16
    let c: I32 = 3i32
    let d: I64 = 4i64
    let e: U8 = 5u8
    let f: U16 = 6u16
    let g: U32 = 7u32
    let h: U64 = 8u64
    let i: F32 = 1.5f32
    let j: F64 = 2.5
    let k: Bool = true
    let l: Char = 'x'
    let m: String = "owned"
    let n: () = ()

    # `Int` is an alias of `I64`, `Float` of `F64`.
    let alias_int: Int = 9
    let alias_float: Float = 9.5

    # No implicit numeric conversion: `as` is always written out,
    # including when it loses precision.
    let narrowed = answer as I32
    let floated = answer as F64
    let truncated = alias_float as Int

    # A borrow is a binding like any other.
    let view: &String = &greeting
    let mut owner = "mutable text"
    let exclusive: &mut String = &mut owner

    println(count)
