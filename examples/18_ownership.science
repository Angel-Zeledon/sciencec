# 18 - Ownership and borrows
# Spec: §6.1 rules, §6.2 region inference, §6.3 auto-borrow at call sites,
# §4.4 record fields that are borrows.
#
# Every program here is meant to be *accepted*: the rejected cases live in
# `tests/ui/`. There is no region syntax anywhere; regions are inferred, and
# the programmer never writes one.

# §6.9 gives `String` no `clone` and makes `truncate` a **mutator**, so a
# shortened copy is built the long way: `String.new()` then `push_str`. Every
# file in the corpus that shortens a borrowed field carries this, because
# there is no prelude name for it to import.
def copy_of(text: &String) -> String:
    let mutable out be String.new()
    out.push_str(text)
    out

type Doc:
    title: String
    body: String

# A record whose field is a borrow. Its region parameter is implicit and
# propagated to every site that instantiates the type (§6.2).
type View:
    source: &Doc

type Editor:
    target: &mut Doc

type Span:
    text: &String
    start: Int
    end: Int

# A `Copy` type. `Copy` has no methods and F0 has no empty block, so the
# implementation is a single line with no block at all (§4.4).
type Position:
    line: U32
    column: U32

Position implements Copy

interface Summarize:
    def summarize(self) -> String

Doc implements Summarize:
    def summarize(self) -> String:
        let mutable out be copy_of(self.body)
        out.truncate(200)
        out

Doc implements Drop:
    def drop(mutable self):
        print("doc dropped")

# --- Moves ------------------------------------------------------------------

# Passing by value moves: the caller may not use the value afterwards.
def consume(doc: Doc) -> String:
    doc.title

# Returning moves ownership out.
def produce() -> Doc:
    Doc(title: "owned", body: "...")

# Rebinding moves too.
def rebind() -> String:
    let first be produce()
    let second be first
    second.title

# --- Shared borrows ---------------------------------------------------------

# Any number of shared borrows may coexist.
def compare(a: &Doc, b: &Doc) -> Bool:
    a.body.length() > b.body.length()

def many_shared():
    let doc be produce()

    # `borrowed` is the unary operator that makes a borrow, and it is what a
    # binding needs: there is no call here to borrow on the programmer's
    # behalf (§4.6).
    let one be &doc
    let two be &doc
    let three be &doc
    print(compare(one, two))
    print(three.summarize())

    # At a call site nothing is written at all: `compare` declares both
    # parameters `borrowed`, so both arguments are &automatically
    # (§6.3). The signature still says which it is, so the reader keeps the
    # information and only the noise goes.
    print(compare(doc, doc))

# A borrow returned from a function: its region is inferred from the argument.
def longest(a: &String, b: &String) -> &String:
    if a.length() > b.length(): a else: b

def title_of(doc: &Doc) -> &String:
    &doc.title

# --- Exclusive borrows ------------------------------------------------------

# Exactly one exclusive borrow, and never at the same time as a shared one.
# Assignment through it uses `be`, the same word that binds (§4.3).
def retitle(doc: &mut Doc, title: String):
    doc.title be title

def exclusive_then_shared():
    let mutable doc be produce()

    # Auto-borrow covers the exclusive case too: `retitle` says
    # `mutable borrowed`, so the caller writes the variable and nothing else.
    retitle(doc, "renamed")

    # The exclusive borrow ended with the call, so a shared one is fine now.
    print(doc.summarize())

    # An explicit borrow remains legal where it clarifies (§6.3).
    retitle(&mut doc, "renamed again")
    print(doc.summarize())

# Borrowing two different fields of the same record at once. Borrows
# auto-dereference for field access, so nothing is written for the outer
# `mutable borrowed`: Science has no dereference operator (§4.7).
def disjoint_fields(doc: &mut Doc) -> Int:
    let title be &doc.title
    let body be &doc.body
    title.length() + body.length()

# --- Borrows stored in records ----------------------------------------------

def store_a_borrow():
    let doc be produce()

    # `view` borrows `doc`. Construction is not a call, so the borrow is
    # written out; the region of the field is inferred so that the borrow
    # cannot outlive its referent (§6.1 rule 5).
    let view be View(source: &doc)
    print(view.source.summarize())
    print(title_of(view.source))

def store_an_exclusive_borrow():
    let mutable doc be produce()
    let editor be Editor(target: &mut doc)
    editor.target.title be "edited"

def span_of(text: &String) -> Span:
    Span(text: text, start: 0, end: text.length())

# --- Copy types -------------------------------------------------------------

# Types implementing `Copy` are not moved by assignment (§6.1 rule 2).
def copies():
    let a be 42
    let b be a
    let c be a
    print(a + b + c)

    let flag be true
    let also be flag
    print(flag and also)

    # A user type that implements `Copy` behaves the same way: `start` is
    # still usable after the assignment, because it was duplicated, not moved.
    let start be Position(line: 1u32, column: 1u32)
    let copied be start
    print(start.line + copied.column)

# --- Box: owned indirection -------------------------------------------------

# `Box` is built through its associated function; named-argument construction
# is for record types only (§4.4).
def boxed() -> Box[Doc]:
    Box.new(produce())

def describe_boxed(value: &Box[Doc]) -> String:
    value.summarize()

# --- Scopes and drop --------------------------------------------------------

def scoped():
    let outer be produce()
    if outer.body.length() > 0:
        # `inner` is destroyed at the end of this block; `Drop` runs there.
        let inner be produce()
        print(inner.summarize())
    print(outer.summarize())

def main():
    many_shared()
    exclusive_then_shared()
    store_a_borrow()
    store_an_exclusive_borrow()
    copies()
    scoped()

    let mutable edited be produce()
    print(disjoint_fields(edited))

    let text be "a &string"
    let span be span_of(text)
    print(span.end)

    print(describe_boxed(boxed()))
    print(rebind())
    print(consume(produce()))
    print(longest("abc", "de"))
