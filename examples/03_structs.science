# 03 - Record types
# Spec: §4.4 declarations, §4.7 smaller rules, §6.2 regions in fields.
#
# `type` is what `struct` was. Covers: declaration, construction with
# mandatory named arguments in any order, field access, nested records,
# generic records, const generic parameters, and fields that are borrows
# (the region is inferred, never written).

type Doc:
    title: String
    body: String

# A field may be a borrow. The region parameter is implicit: the programmer
# never writes one (§6.1).
type View:
    source: borrowed Doc

# Several borrowed fields, shared and exclusive.
type Editor:
    document: mutable borrowed Doc
    template: borrowed Doc
    revision: Int

# A record may hold other records by value.
type Bundle:
    primary: Doc
    secondary: Doc
    label: String

# Generic parameters. One parameter needs no parentheses; more than one does,
# because the comma would otherwise be ambiguous (§4.3).
type Wrapper of T:
    inner: T

type Pair of (A, B):
    first: A
    second: B

# A const generic parameter: a value, not a type (§5.3).
type Grid of (T, const ROWS: Int, const COLS: Int):
    cells: Array of T

type Marker:
    tag: U8

# Marker interfaces are implemented on one line with no block, since there is
# nothing to indent (§4.4).
Marker implements Copy

def make_doc() -> Doc:
    # Construction: named arguments, all mandatory, in any order.
    Doc(title: "a", body: "...")

def make_doc_reordered() -> Doc:
    Doc(body: "...", title: "a")

def title_of(view: borrowed View) -> borrowed String:
    # Borrows auto-dereference for field access, so the chain reads through
    # `source` with nothing written for it: Science has no dereference
    # operator at all (§4.7).
    borrowed view.source.title

# A type may have methods that come from no interface, and a def with no
# `self` receiver is an associated def called through the type (§4.4).
Doc has:
    def new(title: String) -> Doc:
        Doc(title: title, body: String.new())

    def is_empty(self) -> Bool:
        self.body.is_empty()

# An inherent block on a generic type names its parameters the same way the
# declaration does.
Grid of (T, const ROWS: Int, const COLS: Int) has:
    def area() -> Int:
        ROWS * COLS

# Trailing commas are allowed in every parenthesized and bracketed list,
# construction included (§4.7).
def make_pair() -> Pair of (Int, Int):
    Pair(
        first: 1,
        second: 2,
    )

def main():
    let doc be make_doc()

    # A record that stores a borrow of a local. The borrow ends with `view`,
    # so `doc` is still usable afterwards.
    let view be View(source: borrowed doc)
    print(title_of(view))

    let bundle be Bundle(primary: doc, secondary: make_doc_reordered(), label: "pair")
    print(bundle.label)
    print(bundle.primary.title)

    let scratch be Doc.new("scratch")
    print(scratch.is_empty())
    print(make_pair().first)

    let coords be Pair(first: 3, second: 4)
    let mixed be Pair(first: "left", second: 7u8)
    let wrapped be Wrapper(inner: 1_000)
    let marker be Marker(tag: 0xFF)

    print(coords.first)
    print(mixed.second)
    print(wrapped.inner)
    print(marker.tag)

    # An associated def on a generic type takes parentheses around the
    # type, because `Grid of (Int, 3, 3).area()` does not say whether
    # `.area()` belongs to the last argument or to the whole type (§4.3).
    print((Grid of (Int, 3, 3)).area())
