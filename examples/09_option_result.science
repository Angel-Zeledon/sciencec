# 09 - Option, Result and `try`
# Spec: §4.5 error propagation with `try`, §5.5 absence and failure, §8 the
# method sets of `Option` and `Result`.
#
# There is no `null`. Absence is `Option of T`; failure is `Result of (T, E)`.
# `try` unwraps `Ok`/`Some` or returns `Err`/`None` early, propagating the
# error through `From`. It is a prefix word, so it reads as part of the
# sentence rather than as a mark hung off the end of it.

type Config:
    host: String
    port: U16

choice Error:
    NotFound(String)
    Malformed(String)
    Io(String)

choice ParseError:
    Empty
    BadDigit(Char)

# §8 gives `String` no `clone`, so an owned copy is built from `String.new()`
# and `push_str`.
function copy_of(text: borrowed String) -> String:
    let mutable out be String.new()
    out.push_str(text)
    out

function digit_name(c: borrowed Char) -> String:
    match c:
        '0': "zero"
        '1': "one"
        _: "some other character"

# `From` is what lets `try` widen one error type into another. It is a generic
# interface: the source type is the interface's argument (§4.3).
# §8 gives `read_file` and `write_file` the error type `IoError` and declares
# it nowhere else, so widening it is how any function with its own error type
# calls them. See `examples/README.md`.
Error implements From of IoError:
    function from(inner: IoError) -> Self:
        Io("the file could not be read")

Error implements From of ParseError:
    function from(inner: ParseError) -> Self:
        match inner:
            Empty: Malformed("empty input")
            BadDigit(c): Malformed(digit_name(c))

# --- Returning Option -------------------------------------------------------

function heading(text: borrowed String) -> Option of String:
    if text.starts_with("# "):
        Some(text.truncate(60))
    else:
        None

function lookup(settings: borrowed Map of (String, String),
        key: borrowed String) -> Option of (borrowed String):
    settings.get(key)

# `try` on `Option`: unwrap `Some`, or return `None` from the enclosing
# function.
function host_of(settings: borrowed Map of (String, String)) -> Option of String:
    let raw be try lookup(settings, "host")
    let trimmed be try heading(raw)
    Some(trimmed)

# --- The methods §8 actually gives them -------------------------------------

function option_methods(settings: borrowed Map of (String, String)) -> String:
    let found be lookup(settings, "host")
    if found.is_some():
        print("configured")
    # `unwrap_or` consumes the `Option` and hands back the fallback on `None`.
    let port be settings.get("port").unwrap_or("8080")
    copy_of(port)

function result_methods(path: borrowed String) -> String:
    let outcome be read_file(path)
    if outcome.is_ok():
        print("read")
    # `unwrap` panics on `Err`, which is exactly why §8 says so in a comment.
    outcome.unwrap()

# --- Returning Result -------------------------------------------------------

function parse_port(text: borrowed String) -> Result of (U16, ParseError):
    if text.is_empty():
        Err(Empty)
    else:
        Ok(8080u16)

# `read_file` fails with `IoError`, so returning its `Result` unchanged from a
# function declared to fail with `Error` would be a type error. `try` widens it
# through the implementation above, which is the rule this file exists to show.
function read_file_text(path: borrowed String) -> Result of (String, Error):
    Ok(try read_file(path))

function parse_host(text: borrowed String) -> Result of (String, Error):
    if text.starts_with("host="):
        Ok(text.truncate(64))
    else:
        Err(NotFound("host"))

# `try` on `Result`, three times in a row, including one that goes through
# `Error implements From of ParseError`.
function read_config(path: borrowed String) -> Result of (Config, Error):
    let text be try read_file_text(path)
    let host be try parse_host(text)
    let port be try parse_port(text)
    Ok(Config(host: host, port: port))

# `try` inside a larger expression. Because it is a prefix word and not a
# postfix mark, the parentheses are what say how much of the expression it
# covers: here the call, and not the field access that follows it.
function port_plus_one(path: borrowed String) -> Result of (U16, Error):
    Ok((try read_config(path)).port + 1u16)

# --- Consuming them with `match` --------------------------------------------

function report(outcome: borrowed Result of (Config, Error)) -> String:
    match outcome:
        Ok(config): copy_of(config.host)
        Err(NotFound(key)): copy_of(key)
        Err(Malformed(detail)): copy_of(detail)
        Err(Io(detail)): copy_of(detail)

function or_else(value: Option of Int, fallback: Int) -> Int:
    match value:
        Some(inner): inner
        None: fallback

# An arm of type `Never`: `panic` does not return, and coerces to whatever
# the other arms produce (§4.7).
function must_have_host(outcome: Result of (Config, Error)) -> String:
    match outcome:
        Ok(config): config.host
        Err(e): panic("the configuration has no host")

function main():
    let outcome be read_config("science.toml")
    print(report(outcome))

    print(or_else(Some(3), 0))
    print(or_else(None, 0))

    # Qualified variants name the same things (§4.7).
    print(or_else(Option.Some(3), 0))
    print(or_else(Option.None, 0))

    let settings: Map of (String, String) be (Map of (String, String)).new()
    print(option_methods(settings))

    match host_of(settings):
        Some(host): print(host)
        None: print("no host")

    match port_plus_one("science.toml"):
        Ok(port): print(port)
        Err(e): print(report(Err(e)))
