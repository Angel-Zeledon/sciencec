# 08 - Dynamic dispatch
# Spec: §4.3 (the `any Summarize` row of the keyword table), §5.3
# (monomorphization, which is what `any` is the alternative to).
#
# NOTE: that `any Interface` is usable only behind an indirection —
# `borrowed any Interface` or `Box of any Interface` — is the corpus's
# standing reading, not a rule
# the spec states. It follows from the type having no size of its own, and
# every file here obeys it. See `examples/README.md`.
#
# Covers: `any` behind a shared borrow, behind an exclusive borrow, behind
# `Box`, inside a generic container, as a return type, as a record field, and
# the contrast with the statically dispatched version of the same call.

type Doc:
    title: String
    body: String

type Note:
    text: String

# §8 gives `String` no `clone`: an owned copy comes out of `String.new()` and
# `push_str`.
def copy_of(text: borrowed String) -> String:
    let mutable out be String.new()
    out.push_str(text)
    out

interface Summarize:
    def summarize(self) -> String

    def preview(self) -> String:
        self.summarize().truncate(80)

interface Reset:
    def reset(mutable self)

Doc implements Summarize:
    def summarize(self) -> String:
        self.body.truncate(200)

Note implements Summarize:
    def summarize(self) -> String:
        copy_of(self.text)

Note implements Reset:
    def reset(mutable self):
        self.text be ""

# Static dispatch: one specialized copy per `T` (§5.3).
def describe_static of T: Summarize(value: borrowed T) -> String:
    value.preview()

# Dynamic dispatch behind a shared borrow. `any Summarize` is not a type a
# value can have on its own; it is only ever reached through an indirection.
def describe_any(value: borrowed any Summarize) -> String:
    value.preview()

# Dynamic dispatch behind an exclusive borrow.
def clear(value: mutable borrowed any Reset):
    value.reset()

# Dynamic dispatch behind `Box`: the value is owned.
def describe_boxed(value: Box of any Summarize) -> String:
    value.summarize()

# `any` as a return type, again behind the indirection. The signature is
# broken across lines inside the parameter list, where indentation takes no
# part (§4.2).
def pick(flag: Bool, left: borrowed any Summarize,
        right: borrowed any Summarize) -> borrowed any Summarize:
    if flag: left else: right

# `Box` is built through its associated function (§4.4); named-argument
# construction is for record types only.
def into_summary(flag: Bool) -> Box of any Summarize:
    if flag:
        Box.new(Doc(title: "a", body: "..."))
    else:
        Box.new(Note(text: "..."))

# A heterogeneous collection: the element type is erased, which is exactly
# what monomorphization cannot give you. The inner `of` is parenthesized so
# that `Box of any Summarize` reads as one argument to `Array` (§4.3).
def describe_all(items: borrowed Array of (Box of any Summarize)):
    for item in items:
        print(item.preview())

# A record field of `any` type, behind a borrow.
type Renderer:
    target: borrowed any Summarize

# And behind a box, so the record owns it.
type OwningRenderer:
    target: Box of any Summarize

def main():
    let doc be Doc(title: "Dispatch", body: "Static unless you ask otherwise.")
    let mutable note be Note(text: "erased")

    # A parameter declared `borrowed` or `mutable borrowed` is borrowed at the
    # call site without the caller writing anything (§6.3). The same call is
    # dispatched statically first and dynamically after.
    print(describe_static(doc))
    print(describe_any(doc))
    print(describe_any(note))

    clear(note)

    print(describe_boxed(Box.new(Doc(title: "b", body: "..."))))
    print(describe_boxed(into_summary(true)))

    let chosen be pick(true, doc, note)
    print(chosen.summarize())

    # A field is not a parameter, so the borrow is written out with the unary
    # `borrowed` operator (§4.6).
    let renderer be Renderer(target: borrowed doc)
    print(renderer.target.preview())

    let owning be OwningRenderer(target: into_summary(false))
    print(owning.target.preview())

    # The heterogeneous collection, built with `(Array of T).new()` and filled
    # with boxed interface objects.
    let mutable boxes: Array of (Box of any Summarize) be (Array of (Box of any Summarize)).new()
    boxes.push(into_summary(true))
    boxes.push(into_summary(false))
    describe_all(boxes)
