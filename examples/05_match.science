# 05 - Match and patterns
# Spec: §4.5 (`match` is exhaustive; non-exhaustiveness lists the missing
# patterns), §4.7 (qualified variants, `Never`).
#
# Covers every pattern form, arms in inline form and in block form,
# and matches nested inside one another.

choice Format:
    Plain
    Markdown
    Json

choice Token:
    Ident(String)
    Number(Int)
    Symbol(Char)
    Eof

type Point:
    x: Int
    y: Int

# §8 gives `String` no `clone`, so an owned copy is built from `String.new()`
# and `push_str`, which is the whole of what §8 offers for building one.
def copy_of(text: borrowed String) -> String:
    let mutable out be String.new()
    out.push_str(text)
    out

def emphasized(text: borrowed String) -> String:
    let mutable out be String.new()
    out.push_str("*")
    out.push_str(text)
    out.push_str("*")
    out

def quoted(text: borrowed String) -> String:
    let mutable out be String.new()
    out.push_str("\"")
    out.push_str(text)
    out.push_str("\"")
    out

# --- Variant patterns, inline arms ------------------------------------------

def name_of(format: borrowed Format) -> String:
    match format:
        Plain: "plain"
        Markdown: "markdown"
        Json: "json"

# The same match with every pattern qualified by its type. `Plain` and
# `Format.Plain` are the same thing, and the qualified form is what
# disambiguates when two choices in scope share a variant name (§4.7).
def name_of_qualified(format: borrowed Format) -> String:
    match format:
        Format.Plain: "plain"
        Format.Markdown: "markdown"
        Format.Json: "json"

# --- Literal patterns and the wildcard --------------------------------------

def digit_name(digit: Int) -> String:
    match digit:
        0: "zero"
        1: "one"
        2: "two"
        _: "many"

def char_name(c: borrowed Char) -> String:
    match c:
        ',': "comma"
        ';': "semicolon"
        '.': "period"
        _: "symbol"

def is_vowel(c: Char) -> Bool:
    match c:
        'a': true
        'e': true
        'i': true
        'o': true
        'u': true
        _: false

def is_greeting(text: borrowed String) -> Bool:
    match text:
        "hello": true
        "hi": true
        _: false

def describe_flag(flag: Bool) -> String:
    match flag:
        true: "on"
        false: "off"

# --- Variant patterns that bind their payload -------------------------------

def describe(token: borrowed Token) -> String:
    match token:
        Ident(name): copy_of(name)
        Number(value): digit_name(value)
        Symbol(c): char_name(c)
        Eof: "end of input"

# --- Alternatives with `|` --------------------------------------------------

def size_class(n: Int) -> String:
    match n:
        0 | 1 | 2: "small"
        3 | 4 | 5 | 6: "medium"
        _: "large"

def is_punctuation(token: borrowed Token) -> Bool:
    match token:
        Symbol(',') | Symbol(';') | Symbol('.'): true
        _: false

# --- Tuple patterns ---------------------------------------------------------

def quadrant(point: (Int, Int)) -> String:
    match point:
        (0, 0): "origin"
        (x, 0): "on the X axis"
        (0, y): "on the Y axis"
        (_, _): "somewhere else"

# --- Record patterns, which mirror construction with named fields -----------

def classify(point: borrowed Point) -> String:
    match point:
        Point(x: 0, y: 0): "origin"
        Point(x: 0, y: y): "on the Y axis"
        Point(x: x, y: 0): "on the X axis"
        Point(x: x, y: y): "general"

# A record pattern may ignore a field with the wildcard.
def x_of(point: borrowed Point) -> Int:
    match point:
        Point(x: x, y: _): x

# --- A binding pattern that catches everything ------------------------------

def passthrough(n: Int) -> Int:
    match n:
        0: 1
        other: other

# --- An arm that does not return at all -------------------------------------

# `panic` has type `Never`, which coerces to any type. That is what lets one
# arm of a `match` bail out while the others produce a `String` (§4.7).
def require_text(token: borrowed Token) -> String:
    match token:
        Ident(name): copy_of(name)
        Number(value): digit_name(value)
        Symbol(c): char_name(c)
        Eof: panic("expected a token, found the end of input")

# --- Block-form arms, and nesting -------------------------------------------

def render(token: borrowed Token, format: borrowed Format) -> String:
    match token:
        Number(value):
            let doubled be value * 2
            match format:
                Json:
                    quoted(digit_name(doubled))
                Plain | Markdown:
                    digit_name(doubled)
        Ident(name):
            match format:
                Markdown: emphasized(name)
                Plain: copy_of(name)
                Json: quoted(name)
        Symbol(c): char_name(c)
        Eof: ""

# --- A guard written as a comparison ----------------------------------------

# There is no `if` in a pattern, so a condition on the payload goes in the arm
# body.
def shout_level(token: borrowed Token) -> String:
    match token:
        Ident(name):
            if name.length() > 10: "long" else: "short"
        Number(value):
            if value % 2 is 0: "even" else: "odd"
        Symbol(c): char_name(c)
        Eof: "none"

# --- `match` as an expression in a binding ----------------------------------

def main():
    let label be match Markdown:
        Plain: "plain"
        Markdown: "markdown"
        Json: "json"

    print(label)
    print(name_of(Json))
    print(name_of_qualified(Format.Json))
    print(digit_name(2))
    print(size_class(4))
    print(quadrant((0, 3)))
    print(classify(Point(x: 1, y: 0)))
    print(x_of(Point(x: 1, y: 0)))
    print(passthrough(9))
    print(describe(Ident("width")))
    print(render(Number(21), Json))
    print(shout_level(Ident("monomorphization")))
