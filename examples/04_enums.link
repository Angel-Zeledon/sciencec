# 04 - Enums
# Spec: §4.3 enums, §5.5 absence and failure.
#
# Covers: plain enums, generic enums, variants with positional payload,
# variants with several payload fields, the library `Option` and `Result`,
# and enums whose payload is a reference.
#
# F0 has no variants with named fields, so every payload here is positional.

# A C-like enum: every variant is empty.
enum Format:
    Plain
    Markdown
    Json

# Positional payloads, one per variant.
enum Token:
    Ident(String)
    Number(Int)
    Symbol(Char)
    Eof

# Several values in a single variant.
enum Shape:
    Point
    Circle(F64)
    Rect(F64, F64)
    Triangle(F64, F64, F64)

# Generic enums, exactly as the standard library declares them.
enum Option[T]:
    Some(T)
    None

enum Result[T, E]:
    Ok(T)
    Err(E)

# A generic enum over two parameters with mixed payloads.
enum Either[L, R]:
    Left(L)
    Right(R)
    Neither

# An enum whose payload is itself a generic type.
enum Tree[T]:
    Leaf(T)
    Node(Box[Tree[T]], Box[Tree[T]])

# An enum carrying a borrow: the region is inferred like any other.
enum Slot:
    Filled(&String)
    Empty

# Error enums are ordinary enums.
enum ParseError:
    UnexpectedEnd
    BadDigit(Char)
    Unsupported(String)

fn main():
    let format = Markdown
    let ident = Ident("width")
    let number = Number(1_024)
    let symbol = Symbol(':')
    let end = Eof

    let circle = Circle(2.0)
    let rect = Rect(3.0, 4.0)
    let triangle = Triangle(3.0, 4.0, 5.0)

    let present = Some(7)
    let absent: Option[Int] = None
    let good: Result[Int, ParseError] = Ok(1)
    let bad: Result[Int, ParseError] = Err(BadDigit('q'))

    let left: Either[Int, String] = Left(1)
    let right: Either[Int, String] = Right("one")

    let tree = Node(Box(Leaf(1)), Box(Leaf(2)))

    let text = "borrowed"
    let slot = Filled(&text)

    println(number)
